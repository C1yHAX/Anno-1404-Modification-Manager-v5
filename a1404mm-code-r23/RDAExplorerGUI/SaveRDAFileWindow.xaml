<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RDAExplorerGUI.UIConverters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="RDAExplorerGUI.SaveRDAFileWindow"
        Title="RDA Settings" Height="480" Width="640" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="Conv_BoolToVisibility"/>
    </Window.Resources>
    <DockPanel>
    	<Image Source="Images/Headers/headerImage_n05.jpg" Stretch="Fill" DockPanel.Dock="Top" Height="60" Margin="0,0,0,5"/>
    	<DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
    		<Button Content="OK" Width="100" Height="32" DockPanel.Dock="Right" Margin="3" Background="{DynamicResource Brush_UI_White}"
                    Name="button_OK" Click="button_OK_Click" />
    		<Button Content="Cancel" Width="100" Height="32" DockPanel.Dock="Right" Margin="3" Background="{DynamicResource Brush_UI_White}"
                    Name="button_Cancel" Click="button_Cancel_Click" />
    	</DockPanel>
    	<Grid DockPanel.Dock="Top" Margin="3">
    		<Grid HorizontalAlignment="Left" Width="100">
    			<TextBlock TextWrapping="Wrap" Text="Output File" VerticalAlignment="Center" d:LayoutOverrides="Width" HorizontalAlignment="Left"/>
    		</Grid>
    		<TextBox x:Name="field_OutputFile" d:LayoutOverrides="Height" Margin="120,0,28,0" />
    		<Button x:Name="button_SetOutputFile" Content="..." HorizontalAlignment="Right" d:LayoutOverrides="Height" Width="21.96" Background="{DynamicResource Brush_UI_White}"/>
    	</Grid>
    	<Grid DockPanel.Dock="Top" Margin="3">
    		<Grid HorizontalAlignment="Left" Width="100">
    			<TextBlock TextWrapping="Wrap" Text="Compression" VerticalAlignment="Center" d:LayoutOverrides="Width" HorizontalAlignment="Left"/>
    		</Grid>
    		<CheckBox Content="Compress RDA File" HorizontalAlignment="Left" d:LayoutOverrides="Height" Margin="120,0,0,0" IsChecked="True"
                    Name="check_IsCompressed" />
    	</Grid>
        <Grid DockPanel.Dock="Top" Margin="3" Visibility="{Binding IsChecked, ElementName=check_IsCompressed, Converter={StaticResource Conv_BoolToVisibility}}">
    		<Grid HorizontalAlignment="Left" Width="100">
    			<TextBlock TextWrapping="Wrap" Text="Compressed Types" VerticalAlignment="Top" d:LayoutOverrides="Width" HorizontalAlignment="Left"/>
    		</Grid>
    		<WrapPanel x:Name="compressedTypesPanel" Margin="150,0,0,0" Orientation="Vertical" />
    	</Grid>
    </DockPanel>
</Window>
