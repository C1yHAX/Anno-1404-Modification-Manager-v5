<UserControl x:Class="DevelopmentTools.Editors.ModificationInfo.ModificationInfoEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:devctrls="clr-namespace:DevelopmentTools.Controls"
             xmlns:ammlgctrls="clr-namespace:AnnoModificationManager4.Language;assembly=AnnoModificationManager4"
             mc:Ignorable="d" 
             d:DesignHeight="1024" d:DesignWidth="640" Focusable="True" >
    <Grid Background="White">
        <Border HorizontalAlignment="Left" Width="190" VerticalAlignment="Stretch" Margin="0,140,0,0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush_UI_Border}"/>
        <Image Height="80" HorizontalAlignment="Stretch" Margin="190,0,0,0" Stretch="Fill" VerticalAlignment="Top" Width="Auto"
                Source="/DevelopmentTools;component/Images/Header/headerImage_n05.jpg" />
        <ScrollViewer Margin="190,84,0,0" ScrollViewer.VerticalScrollBarVisibility="Visible">
        	<StackPanel>
        		<Grid Height="21.96" Margin="8,0">
        			<TextBox x:Name="Field_InternalName" TextWrapping="NoWrap" Text="TextBox" VerticalAlignment="Bottom" Margin="100,0,0,0"
        				TextChanged="Field_UpdateModification" />
        			<Grid HorizontalAlignment="Left" Width="100">
        				<TextBlock TextWrapping="NoWrap" Text="Internal Name" d:LayoutOverrides="Width, Height" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        			</Grid>
        		</Grid>
        		<Grid Height="21.96" Margin="8,3,8,0">
        			<TextBox x:Name="Field_Category" TextWrapping="NoWrap" Text="TextBox" VerticalAlignment="Bottom" Margin="100,0,0,0"
        				TextChanged="Field_UpdateModification" />
        			<Grid HorizontalAlignment="Left" Width="100">
        				<TextBlock TextWrapping="NoWrap" Text="Internal Category" d:LayoutOverrides="Width, Height" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        			</Grid>
        		</Grid>
        		<Grid Height="21.96" Margin="8,8,8,0">
        			<TextBox x:Name="Field_Author" TextWrapping="NoWrap" Text="TextBox" VerticalAlignment="Bottom" Margin="100,0,0,0"
        				TextChanged="Field_UpdateModification" />
        			<Grid HorizontalAlignment="Left" Width="100">
        				<TextBlock TextWrapping="NoWrap" Text="Author" d:LayoutOverrides="Width, Height" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        			</Grid>
        		</Grid>
        		<Grid Height="21.96" Margin="8,3,8,0">
        			<TextBox x:Name="Field_Website" TextWrapping="NoWrap" Text="TextBox" VerticalAlignment="Bottom" Margin="100,0,0,0"
        				TextChanged="Field_UpdateModification" />
        			<Grid HorizontalAlignment="Left" Width="100">
        				<TextBlock TextWrapping="NoWrap" Text="Website" d:LayoutOverrides="Width, Height" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        			</Grid>
        		</Grid>
        		<Grid Height="21.96" Margin="8,3,8,0">
        			<TextBox x:Name="Field_Documentation" TextWrapping="NoWrap" Text="TextBox" VerticalAlignment="Bottom" Margin="100,0,52,0"
        				TextChanged="Field_UpdateModification" IsEnabled="False" />
        			<Grid HorizontalAlignment="Left" Width="100">
        				<TextBlock TextWrapping="NoWrap" Text="Documentation" d:LayoutOverrides="Width, Height" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        			</Grid>
        			<Button Click="Field_Documentation_Open_Click"  x:Name="Field_Documentation_Open" Content="..." HorizontalAlignment="Right" Width="22" d:LayoutOverrides="Height" Background="{DynamicResource Brush_UI_White}"/>
        			<devctrls:DropDownButton HorizontalAlignment="Right" Width="22" Background="{DynamicResource Brush_UI_White}" d:LayoutOverrides="Height" Margin="0,0,26,0">
        				<devctrls:DropDownButton.DropDown>
        					<ContextMenu>
        						<MenuItem Click="Field_Documentation_Create_Click" Header="Create" x:Name="Field_Documentation_Create">
        							<MenuItem.Icon>
        								<Image Source="/DevelopmentTools;component/Images/Icons/page_white.png" />
        							</MenuItem.Icon>
        						</MenuItem>
        						<MenuItem Click="Field_Documentation_Edit_Click" Header="Open/Edit" x:Name="Field_Documentation_Edit">
        							<MenuItem.Icon>
        								<Image Source="/DevelopmentTools;component/Images/Icons/pencil.png" />
        							</MenuItem.Icon>
        						</MenuItem>
        						<MenuItem Click="Field_Documentation_Remove_Click" Header="Remove" x:Name="Field_Documentation_Remove">
        							<MenuItem.Icon>
        								<Image Source="/DevelopmentTools;component/Images/Icons/cross.png" />
        							</MenuItem.Icon>
        						</MenuItem>
        					</ContextMenu>
        				</devctrls:DropDownButton.DropDown>
        				<Image Source="/DevelopmentTools;component/Images/Icons/asterisk_yellow.png" />
        			</devctrls:DropDownButton>
        		</Grid>
        		<Grid Height="21.96" Margin="8,8,8,0">
        			<Grid HorizontalAlignment="Left" Width="100">
        				<TextBlock TextWrapping="NoWrap" Text="Version" d:LayoutOverrides="Width, Height" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        			</Grid>
        			<Grid Margin="100,0,0,0">
        				<UniformGrid Columns="4" Width="200" HorizontalAlignment="Left">
        					<TextBox x:Name="Field_Version_Major" TextWrapping="NoWrap" Text="1" HorizontalAlignment="Left" Width="40"
        						TextChanged="Version_UpdateModification" />
        					<TextBox x:Name="Field_Version_Minor" TextWrapping="NoWrap" Text="0" HorizontalAlignment="Left" Width="40"
        						TextChanged="Version_UpdateModification" />
        					<TextBox x:Name="Field_Version_Build" TextWrapping="NoWrap" Text="0" HorizontalAlignment="Left" Width="40"
        						TextChanged="Version_UpdateModification" />
        					<TextBox x:Name="Field_Version_Revision" TextWrapping="NoWrap" Text="0" HorizontalAlignment="Left" Width="40"
        						TextChanged="Version_UpdateModification" />
        				</UniformGrid>
        			</Grid>
        		</Grid>
                <!--<CheckBox Name="chb_IgnoreNonExistingRDAs" Content="Ignore non-existing RDA files"  Margin="8,5,0,0"
                        Checked="AnnoVersion_UpdateModification" Unchecked="AnnoVersion_UpdateModification" />-->
        		<GroupBox Header="Anno Versions" Margin="8,8,8,0" Height="Auto">
                    <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="AnnoVersions_All" Content="All Versions" Checked="AnnoVersion_UpdateModification" Unchecked="AnnoVersion_UpdateModification" />
                        <Separator  Height="10" HorizontalAlignment="Left" Width="100" VerticalAlignment="Top" d:LayoutOverrides="Height"/>
                        <CheckBox x:Name="AnnoVersions_Retail" Content="Retail" Checked="AnnoVersion_UpdateModification" Unchecked="AnnoVersion_UpdateModification" />
                        <CheckBox x:Name="AnnoVersions_Patch1" Content="Patch 1" Checked="AnnoVersion_UpdateModification" Unchecked="AnnoVersion_UpdateModification" />
                        <CheckBox x:Name="AnnoVersions_Patch2" Content="Patch 2" Checked="AnnoVersion_UpdateModification" Unchecked="AnnoVersion_UpdateModification" />
                        <CheckBox x:Name="AnnoVersions_Patch3" Content="Patch 3" Checked="AnnoVersion_UpdateModification" Unchecked="AnnoVersion_UpdateModification" />
                        <CheckBox x:Name="AnnoVersions_IAAM" Content="IAAM Mod" Checked="AnnoVersion_UpdateModification" Unchecked="AnnoVersion_UpdateModification" />
                        <Separator Height="10" HorizontalAlignment="Left" Width="100" VerticalAlignment="Top" d:LayoutOverrides="Height"/>
                        <CheckBox x:Name="AnnoVersions_Addon1" Content="Addon 1" Checked="AnnoVersion_UpdateModification" Unchecked="AnnoVersion_UpdateModification" />
                       <CheckBox x:Name="AnnoVersions_Addon1_Patch1" Content="Addon 1 Patch 1" Checked="AnnoVersion_UpdateModification" Unchecked="AnnoVersion_UpdateModification" />
                    </StackPanel>
                </GroupBox>
                <ammlgctrls:LabelEditor Margin="8,8,8,0" x:Name="LabelEditor_Name" />
        		<ammlgctrls:LabelEditor Margin="8,3,8,0" x:Name="LabelEditor_Category" />      
        		<ammlgctrls:LabelEditor_Big Margin="8,8,8,0" x:Name="LabelEditor_Description"/>
        		<GroupBox Header="Images" Margin="8,8,8,0" Height="200">
        			<Grid>
        				<ToolBar Height="27" VerticalAlignment="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush_UI_Border}" IsOverflowOpen="False">
        					<Button Click="Images_Add_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="Images_Add">
        						<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add.png" Stretch="UniformToFill" Width="16"/>
        					</Button>
        					<Button Click="Images_Remove_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="Images_Remove">
        						<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/delete.png" Stretch="UniformToFill" Width="16"/>
        					</Button>
        				</ToolBar>
        				<ListView Margin="0,0,0,27" BorderBrush="{x:Null}" BorderThickness="0" Foreground="Black" Name="Images">
                            <!--<ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" Width="{Binding ActualWidth, ElementName=Images}"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>-->
                                <ListView.View>                                      
        						<GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style>
                                            <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
        							<GridViewColumn/>
        						</GridView>
        					</ListView.View>                              
                        </ListView>
        			</Grid>
        		</GroupBox>
        	</StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
