    PublicKeyToken=31bf3856ad364e35, ProcessorArchitecture=MSIL;component/themes/aero.normalcolor.xaml" />
                <ResourceDictionary Source="Brushes.xaml"/>                           
    			<ResourceDictionary Source="ControlStyle_TreeViewItem_Global.xaml"/>
    			<ResourceDictionary Source="ControlStyle_Expander_Headerless.xaml"/>
    			<ResourceDictionary Source="ControlStyle_ProgressBar_Global.xaml"/>      				
    			<ResourceDictionary Source="ControlStyle_ListViewItem_Global.xaml"/>
    			<ResourceDictionary Source="ControlStyle_TabItem_Global.xaml"/>
                <ResourceDictionary Source="ControlStyle_Toolbar_Global.xaml"/>
                <ResourceDictionary Source="ControlStyle_Button_NoBorder.xaml"/>
                <ResourceDictionary Source="ControlStyle_NumericUpDown_Global.xaml"/>
            </ResourceDictionary.MergedDictionaries>
    	</ResourceDictionary>            
         
    </Application.Resources>
