<Window x:Class="AnnoModificationManager4.UserInterface.Misc.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lng="clr-namespace:AnnoModificationManager4.Language.DictionarySystem"
        xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        Loaded="MessageWindow_Loaded" Title="" Height="375" Width="475" WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen">
    <Grid>
        <Image Height="80" HorizontalAlignment="Left" Name="image1" Stretch="Fill" VerticalAlignment="Top" Width="459"
                Source="/AnnoModificationManager4;component/Images/Header/headerImage_n05.jpg" Opacity="0.5" />
        <TextBlock x:Name="Message" Margin="8,84,8,42" TextWrapping="Wrap" Text="TextBlock"/>
        <TextBox PreviewKeyDown="TextInput_PreviewKeyDown" AcceptsTab="True" AcceptsReturn="True" x:Name="TextInput" TextWrapping="NoWrap" Margin="8,140,8,42" Visibility="Collapsed"/>
        <!--<avalon:TextEditor WordWrap="False" FontFamily="Courier New" x:Name="XmlInput" Margin="8,140,8,42" Visibility="Collapsed"/>-->
        <DockPanel Height="30" Margin="8,0,3,8" VerticalAlignment="Bottom" LastChildFill="False">
        	<Button x:Name="button_ok" Content="OK" Width="100" DockPanel.Dock="Right" Background="{DynamicResource Brush_UI_White}" Margin="0,0,5,0"
                    Click="button_ok_Click" />
            <Button x:Name="button_yes" Content="{lng:LanguageMarkup Dictionary=UserInterface,Key=Yes}" Width="100" DockPanel.Dock="Right" Background="{DynamicResource Brush_UI_White}" Margin="0,0,5,0"
                    Click="button_yes_Click" />
            <Button x:Name="button_no" Content="{lng:LanguageMarkup Dictionary=UserInterface,Key=No}" Width="100" DockPanel.Dock="Right" Background="{DynamicResource Brush_UI_White}"
                    Margin="0,0,5,0" Click="button_no_Click" />
            <Button x:Name="button_cancel" Content="{lng:LanguageMarkup Dictionary=UserInterface,Key=Cancel}" Width="100" Background="{DynamicResource Brush_UI_White}" DockPanel.Dock="Right"
                    Margin="0,0,5,0" Click="button_cancel_Click" />
        </DockPanel>
    </Grid>
</Window>
