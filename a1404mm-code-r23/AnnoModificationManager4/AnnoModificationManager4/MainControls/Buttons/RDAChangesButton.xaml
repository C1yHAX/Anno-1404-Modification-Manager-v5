<Button x:Class="AnnoModificationManager4.MainControls.Buttons.RDAChangesButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:lng="clr-namespace:AnnoModificationManager4.Language.DictionarySystem"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" Style="{DynamicResource ButtonStyle_Button_NoBorder}" Loaded="Button_Loaded"
        Click="Button_Click">
    <Button.Resources>
        <StackPanel Orientation="Horizontal" x:Key="state_Normal">
            <Image Width="16" Height="16" Source="/AnnoModificationManager4;component/Images/Icons/tick.png" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" x:Key="state_Alert">
            <Image Width="16" Height="16" Source="/AnnoModificationManager4;component/Images/Icons/asterisk_yellow.png" />
            <TextBlock VerticalAlignment="Center" Margin="5,0,0,0" Text="{lng:LanguageMarkup Dictionary=MainUI, Key=ToolBar_RDA_ApplyChanges}"/>
        </StackPanel>
    </Button.Resources>
</Button>
