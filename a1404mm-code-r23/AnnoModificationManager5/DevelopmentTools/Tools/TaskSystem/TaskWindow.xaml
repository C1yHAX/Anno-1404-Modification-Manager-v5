<Window x:Class="DevelopmentTools.Tools.TaskSystem.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasks" Height="480" Width="640" Loaded="Window_Loaded" Closed="Window_Closed"
        Icon="/DevelopmentTools;component/Images/Icons/hourglass.png" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" ShowsPreview="True"/>

        <Grid Grid.Column="0">
        <TreeView MouseDoubleClick="TaskTreeView_MouseDoubleClick" SelectedItemChanged="TaskTreeView_SelectedItemChanged" Margin="0,0,0,27" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush_UI_Border}"
                Name="TaskTreeView" />
    	<ToolBar Height="27" VerticalAlignment="Bottom" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush_UI_Border}" IsOverflowOpen="False">
    		<Button Click="AddTaskList_Click"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="AddTaskList">
    			<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/key_add.png" Stretch="Fill" Width="16"/>
    		</Button>
    		<Button Click="AddTask_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="AddTask">
    			<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add.png" Stretch="Fill" Width="16"/>
    		</Button>
    		<Button Click="Remove_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="Remove">
    			<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/delete.png" Stretch="Fill" Width="16"/>
    		</Button>
    	</ToolBar>
        </Grid>
        <ContentPresenter x:Name="CurrentTaskViewer" Grid.Column="2"/>        
    </Grid>
</Window>
