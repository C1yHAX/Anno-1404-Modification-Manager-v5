<Window x:Class="DevelopmentTools.Tools.Global.TestTool"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test Tool" Height="500" Width="700"
        Icon="/DevelopmentTools;component/Images/Logo/Version3_Comet20.ico" WindowStartupLocation="CenterScreen">
    <Grid>
    	<Image Margin="0" Source="/DevelopmentTools;component/Images/Header/headerImage_n05.jpg" Stretch="Fill" Height="80" VerticalAlignment="Top"/>
    	<TabControl Margin="8,42,8,8" Background="White" Name="tabControl">
    		<TabItem Header="Start" IsEnabled="False">
    			<Grid Background="White">
    				<DockPanel Height="30" Margin="8,0,8,8" VerticalAlignment="Bottom" LastChildFill="False">
    					<Button x:Name="button_StartTest" Content="Start Test" Width="100" DockPanel.Dock="Right" Background="{DynamicResource Brush_UI_White}" Margin="0,0,5,0"
    						Click="button_StartTest_Click"/>
    				</DockPanel>
    				<Label Content="This Test Tool will check, if all Xml- and List Modifiers are activated and deactivated without problems." Margin="8,8,8,42"/>
    			</Grid>
    		</TabItem>
    		<TabItem Header="Test" IsEnabled="False">
    			<Grid Background="White">
    				<ListView Foreground="Black" BorderBrush="{x:Null}" BorderThickness="0" Name="testList">
    					<ListView.View>
    						<GridView>
                                <GridViewColumn Width="Auto">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="/DevelopmentTools;component/Images/Icons/information.png" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="500" />
                            </GridView>
    					</ListView.View>
    				</ListView>
    			</Grid>
    		</TabItem>
			<TabItem Header="Result" IsEnabled="False">
    			<Grid Background="White">
    				<DockPanel Height="30" Margin="8,0,8,8" VerticalAlignment="Bottom" LastChildFill="False">
    					<Button x:Name="button_Close" Content="Close" Width="100" DockPanel.Dock="Right" Background="{DynamicResource Brush_UI_White}" Margin="0,0,5,0"
    						Click="button_Close_Click"/>
    					<Button x:Name="button_SaveResult" Content="Save Result ..." Width="100" DockPanel.Dock="Right" Background="{DynamicResource Brush_UI_White}" Margin="0,0,5,0"
    						Click="button_SaveResult_Click"/>
                        <Button x:Name="button_OpenFolder" Content="Open Folder ..." Width="100" DockPanel.Dock="Right" Background="{DynamicResource Brush_UI_White}" Margin="0,0,5,0"
    						Click="button_OpenFolder_Click"/>
    				</DockPanel>
                    <TreeView Margin="0,0,0,42" Foreground="Black" BorderBrush="{x:Null}" BorderThickness="0" Name="resultList"/>
                </Grid>
    		</TabItem>
    	</TabControl>
        
    </Grid>
</Window>
