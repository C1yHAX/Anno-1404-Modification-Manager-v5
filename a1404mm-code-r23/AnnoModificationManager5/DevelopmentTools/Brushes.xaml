<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- Dark theme (matches the Mod Manager) -->
	<SolidColorBrush x:Key="Brush_UI_White" Color="#FF0F172A"/>
	<LinearGradientBrush x:Key="Brush_UI_Blue" EndPoint="0.5,1" StartPoint="0.5,0">
		<GradientStop Color="#FF3A5A86" Offset="0"/>
		<GradientStop Color="#FF285A9C" Offset="1"/>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Brush_UI_Border" Color="#FF294A72"/>
	<LinearGradientBrush x:Key="Brush_UI_DarkGrayBrush" EndPoint="0.5,1" StartPoint="0.5,0">
		<GradientStop Color="#FF21344C" Offset="0"/>
		<GradientStop Color="#FF18283C" Offset="1"/>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Brush_UI_TextEditor" EndPoint="0,20" MappingMode="Absolute" StartPoint="0,0">
		<GradientStop Color="#FF0F172A" Offset="0.05"/>
		<GradientStop Color="#FF1E3554" Offset="0.07"/>
		<GradientStop Color="#FF1E3554" Offset="1"/>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Brush_UI_MediumGray" EndPoint="0.5,1" StartPoint="0.5,0">
		<GradientStop Color="#FF1D2E45" Offset="0"/>
		<GradientStop Color="#FF17273B" Offset="1"/>
	</LinearGradientBrush>
</ResourceDictionary>
