<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DevelopmentTools.Editors.ListModule" x:Class="DevelopmentTools.Editors.ListModule.ListModuleEditor_Main" 
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="640" Background="White" Focusable="True">
    <Grid>
        <TreeView SelectedItemChanged="FileList_SelectedItemChanged"  MouseLeftButtonUp="FileList_MouseLeftButtonUp" HorizontalAlignment="Left" Width="190" VerticalAlignment="Stretch" Margin="0,140,0,28" BorderThickness="0,1,1,0" BorderBrush="{DynamicResource Brush_UI_Border}" Name="FileList" />
        <Grid x:Name="ModifierListEditor" Margin="190,0,0,0" Visibility="Hidden">  
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" ShowsPreview="True"/>
            
        	<TreeView Grid.Column="2" MouseLeftButtonUp="ModuleList_MouseLeftButtonUp" MouseDoubleClick="ModuleList_MouseDoubleClick" SelectedItemChanged="ModuleList_SelectedItemChanged" x:Name="ModuleList" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="1,0,0,0" HorizontalAlignment="Stretch" Margin="0,0,0,28"/>
            <ContentPresenter x:Name="ModuleEditPanel" Grid.Column="0"/>
            <local:ListModuleEditor_ModuleCreator Grid.Column="0" x:Name="ModuleCreator" Visibility="Visible" />              
            <ToolBar Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="28" Background="{DynamicResource Brush_UI_White}" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="1,1,0,0" IsOverflowOpen="False">
        		<Button Click="ModuleList_Add_Click" x:Name="ModuleList_Add" Margin="3,0,0,0">
        			<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add.png" Stretch="Fill" Width="16"/>
        		</Button>
                <Button Click="ModuleList_Remove_Click" x:Name="ModuleList_Remove">
        			<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/delete.png" Stretch="Fill" Width="16"/>    			 		
        		</Button>
                <Button Click="ModuleList_Rename_Click" x:Name="ModuleList_Rename">
        			<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/pencil.png" Stretch="Fill" Width="16"/>
        		</Button>                
                <Separator Margin="5,0,0,0"/>
                <Button Click="ModuleList_Move_Up_Click" x:Name="ModuleList_Move_Up">
                	<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/resultset_top.png" Stretch="Fill" Width="16"/>
                </Button>
                <Button Click="ModuleList_Move_Down_Click" x:Name="ModuleList_Move_Down">
                	<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/resultset_bottom.png" Stretch="Fill" Width="16"/>
                </Button>
                <Separator Margin="5,0,0,0"/>
                <Button Click="ModuleList_Move_ToLastGroup_Click" x:Name="ModuleList_Move_ToLastGroup">
                    <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/key_up.png" Stretch="Fill" Width="16"/>
                </Button>
                <Button Click="ModuleList_Move_ToNextGroup_Click" x:Name="ModuleList_Move_ToNextGroup">
                    <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/key_down.png" Stretch="Fill" Width="16"/>
                </Button>
            </ToolBar>
        </Grid>
    	<ToolBar HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="28" Width="190" Background="{DynamicResource Brush_UI_White}" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0,1,1,0" IsOverflowOpen="False">
    	    <Button Click="FileList_Add_Click" x:Name="FileList_Add" Margin="3,0,0,0">
    			<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add.png" Stretch="Fill" Width="16"/>
            </Button>        
    		<Button Click="FileList_Remove_Click" x:Name="FileList_Remove">
    			<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/delete.png" Stretch="Fill" Width="16"/>    			 		
			</Button> 
			<Button Click="FileList_Rename_Click" x:Name="FileList_Rename">
				<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/pencil.png" Stretch="Fill" Width="16"/>
			</Button>
			<Separator Margin="5,0,0,0"/>
			<Button Click="FileList_Move_Up_Click" x:Name="FileList_Move_Up">
				<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/resultset_top.png" Stretch="Fill" Width="16"/>
			</Button>
			<Button Click="FileList_Move_Down_Click" x:Name="FileList_Move_Down">
				<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/resultset_bottom.png" Stretch="Fill" Width="16"/>
			</Button>  	
		</ToolBar>
    </Grid>
</UserControl>
