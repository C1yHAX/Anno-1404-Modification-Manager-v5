<UserControl x:Class="DevelopmentTools.Editors.ModuleManager.ModuleManager_Main"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ctrls="clr-namespace:AnnoModificationManager5.Controls;assembly=AnnoModificationManager5"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="640">
    <Grid Background="{DynamicResource Brush_UI_White}">
        <Border Width="0" Visibility="Collapsed"/>
        <TabControl Margin="8,8,8,8" BorderBrush="{DynamicResource Brush_UI_Border}">
        	<TabItem Header="Original Files">
        		<Grid Background="{DynamicResource Brush_UI_White}">
        			<ListView BorderBrush="{x:Null}" Foreground="#FFE8EEF8" BorderThickness="0" Name="list_OriginalFiles" ScrollViewer.HorizontalScrollBarVisibility="Disabled">               
                        <ListView.View>
        					<GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style>
                                        <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="{Binding ActualWidth, ElementName=list_OriginalFiles}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding File}"/>
                                                <ctrls:ContentButton Click="button_originalFiles_SetSourceFile_Click" Binding="{Binding}" Background="{StaticResource Brush_UI_White}" DockPanel.Dock="Right" Name="button_originalFiles_SetSourceFile">
                                                    <Image Source="/DevelopmentTools;component/Images/Icons/folder.png" Width="16" Height="16" />
                                                </ctrls:ContentButton>
                                                <ctrls:ContentButton Click="button_originalFiles_ShowSourceFile_Click" Binding="{Binding}" Background="{StaticResource Brush_UI_White}" Margin="0,0,3,0" DockPanel.Dock="Right" Name="button_originalFiles_ShowSourceFile">
                                                    <Image Source="/DevelopmentTools;component/Images/Icons/zoom.png" Width="16" Height="16" />
                                                </ctrls:ContentButton>
                                                <!--<Border Margin="5,3,5,3" DockPanel.Dock="Right" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush_UI_Border}"/>
                                                <ctrls:ContentButton Click="button_originalFiles_SetDestination_Click" Binding="{Binding}" Background="{StaticResource Brush_UI_White}" DockPanel.Dock="Right" Name="button_originalFiles_SetDestination">
                                                    <Image Source="/DevelopmentTools;component/Images/Icons/pencil.png" Width="16" Height="16" />                                                        
                                                </ctrls:ContentButton>
                                                <Border Margin="5,3,5,3" DockPanel.Dock="Right" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush_UI_Border}"/>
                                                <TextBlock Text="{Binding SourceFileSize}" Foreground="Gray" DockPanel.Dock="Right"/>-->
                                            </DockPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
        				</ListView.View>
        			</ListView>
        		</Grid>
        	</TabItem>
        </TabControl>
    </Grid>
</UserControl>
