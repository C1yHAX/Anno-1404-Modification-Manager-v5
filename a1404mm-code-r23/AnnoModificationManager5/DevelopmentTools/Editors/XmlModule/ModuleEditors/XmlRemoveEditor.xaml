<UserControl
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:bot="clr-namespace:PixelLab.Wpf;assembly=PixelLab.Wpf" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit" mc:Ignorable="d"
    x:Class="DevelopmentTools.Editors.XmlModule.ModuleEditors.XmlRemoveEditor"
        d:DesignWidth="700" d:DesignHeight="800" Background="{DynamicResource Brush_UI_White}" Focusable="True">
    <Grid>
        <Image Height="0" Visibility="Collapsed" x:Name="image1" Stretch="Fill" VerticalAlignment="Top"
                Source="/DevelopmentTools;component/Images/Header/headerImage_n05.jpg" >
        	<Image.OpacityMask>
        		<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
        			<LinearGradientBrush.RelativeTransform>
        				<TransformGroup>
        					<ScaleTransform CenterY="0.5" CenterX="0.5"/>
        					<SkewTransform CenterY="0.5" CenterX="0.5"/>
        					<RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
        					<TranslateTransform/>
        				</TransformGroup>
        			</LinearGradientBrush.RelativeTransform>
        			<GradientStop Color="Black" Offset="0"/>
        			<GradientStop Color="White" Offset="0.365"/>
        		</LinearGradientBrush>
        	</Image.OpacityMask>
        </Image>
        <DockPanel Height="30" Margin="8,0,3,8" VerticalAlignment="Bottom" LastChildFill="False">
        	<Button x:Name="button_ok" Content="Apply" Width="100" DockPanel.Dock="Right" Background="{DynamicResource Brush_UI_White}" Margin="0,0,5,0"
                    Click="button_ok_Click" />
        	<Button x:Name="button_cancel" Content="Discard" Width="100" Background="{DynamicResource Brush_UI_White}" DockPanel.Dock="Right" Margin="0,0,5,0" Click="button_cancel_Click" />
        	<Button x:Name="button_test" Content="Test Modifier" Width="100" Background="{DynamicResource Brush_UI_White}" Margin="0,0,5,0"
        		Click="button_test_Click" />
            <Button x:Name="button_select" DockPanel.Dock="Right" Content="Editor" Width="100" Background="{DynamicResource Brush_UI_White}" Margin="0,0,5,0"
        		Click="button_select_Click" />
        </DockPanel>
        <TabControl Margin="8,8,8,42" BorderBrush="{DynamicResource Brush_UI_Border}" >
        	<TabItem Header="Modifier" IsSelected="True">
        		<DockPanel Background="{DynamicResource Brush_UI_White}">
        			<Border BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0,0,0,1" VerticalAlignment="Top" DockPanel.Dock="Top" Margin="0,0,0,3">
        				<Label Margin="0" >
        					<TextBlock Text="If the modifier will be deactivated, the Manager will add a new XmlNode (Name: [Tag Name]) with the InnerXml" TextWrapping="Wrap"/>  				
        				</Label>
        			</Border>
        			<Grid Height="22" HorizontalAlignment="Stretch" VerticalAlignment="Top" DockPanel.Dock="Top" Margin="5,3,5,0" >
        				<Grid HorizontalAlignment="Left" Width="100">
        					<TextBlock HorizontalAlignment="Left" TextWrapping="NoWrap" Text="File" d:LayoutOverrides="Height" VerticalAlignment="Center"/>
        				</Grid>
                        <ComboBox IsEditable="True" x:Name="Field_DestinationFile" Margin="100,0,50,0" Height="22" DropDownOpened="Field_DestinationFile_DropDownOpened"/>
                        <Button Margin="0,0,25,0" Background="{DynamicResource Brush_UI_White}" Click="Field_DestinationFile_Inspect_Click" x:Name="Field_DestinationFile_Inspect" HorizontalAlignment="Right" Width="22" Height="22" Padding="0">
                            <Image Source="/DevelopmentTools;component/Images/Icons/zoom.png" Width="16" Height="16"/>
                        </Button>
                        <Button Background="{DynamicResource Brush_UI_White}"  HorizontalAlignment="Right" Width="22" Height="22" Padding="0" x:Name="b_DestinationFile_Select" Click="b_DestinationFile_Select_Click">
                            ...
                        </Button>
                    </Grid>
        			<Separator Margin="2,7,-157,7" DockPanel.Dock="Top"/>
        			<Grid Height="22" HorizontalAlignment="Stretch" VerticalAlignment="Top" DockPanel.Dock="Top" Margin="5,3,5,0" >
        				<Grid HorizontalAlignment="Left" Width="100">
        					<TextBlock HorizontalAlignment="Left" TextWrapping="NoWrap" Text="Selector" d:LayoutOverrides="Height" VerticalAlignment="Center"/>
        				</Grid>
        				<TextBox x:Name="Field_Selector" Margin="100,0,26,0" Height="22"/>
        				<Button Background="{DynamicResource Brush_UI_White}" Click="Field_Selector_Inspect_Click" x:Name="Field_Selector_Inspect" HorizontalAlignment="Right" Width="22" Height="22" Padding="0">
        					<Image Source="/DevelopmentTools;component/Images/Icons/zoom.png" Width="16" Height="16"/>
        				</Button>
        			</Grid>
        			<Separator Margin="2,7,-157,7" DockPanel.Dock="Top"/>
        			<Grid Height="22" HorizontalAlignment="Stretch" VerticalAlignment="Top" DockPanel.Dock="Top" Margin="5,3,5,0">
        				<Grid HorizontalAlignment="Left" Width="100">
        					<TextBlock HorizontalAlignment="Left" TextWrapping="NoWrap" Text="Deselector" d:LayoutOverrides="Height" VerticalAlignment="Center"/>
        				</Grid>
        				<TextBox x:Name="Field_Deselector" Margin="100,0,0,0" Height="22" BorderBrush="{DynamicResource Brush_UI_TextEditor}"/>
        			</Grid>
                    <Grid Height="22" HorizontalAlignment="Stretch" VerticalAlignment="Top" DockPanel.Dock="Top" Margin="5,5,5,0" >
                        <Grid HorizontalAlignment="Left" Width="100">
                            <TextBlock HorizontalAlignment="Left" TextWrapping="NoWrap" Text="Add At" d:LayoutOverrides="Height" VerticalAlignment="Center"/>
                        </Grid>
                        <bot:NumericUpDown Margin="100,0,0,0" Height="22" Minimum="-1" Value="-1" ToolTip="Set to -1 to add at the end of XmlNode Collection." Name="Field_AddBefore" />
                    </Grid>
        			<Grid Height="22" Margin="5,5,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" DockPanel.Dock="Top" >
        				<Grid HorizontalAlignment="Left" Width="100">
        					<TextBlock HorizontalAlignment="Left" TextWrapping="NoWrap" Text="Tag Name" d:LayoutOverrides="Height" VerticalAlignment="Center"/>
        				</Grid>
        				<TextBox x:Name="Field_TagName" Margin="100,0,26,0" Height="22" TextChanged="Field_TagName_TextChanged"/>
        				<Button Background="{DynamicResource Brush_UI_White}" Click="Field_TagName_Inspect_Click" x:Name="Field_TagName_Inspect" HorizontalAlignment="Right" Width="22" Height="22" Padding="0">
        					<Image Source="/DevelopmentTools;component/Images/Icons/zoom.png" Width="16" Height="16"/>
        				</Button>
        			</Grid>
        			<Grid Margin="5">
        				<Grid HorizontalAlignment="Left" Width="100" Height="22" VerticalAlignment="Top">
        					<TextBlock HorizontalAlignment="Left" TextWrapping="NoWrap" Text="InnerXml" d:LayoutOverrides="Height" VerticalAlignment="Center"/>
        				</Grid>
        				<Border Margin="100,0,0,0" BorderBrush="{DynamicResource Brush_UI_TextEditor}" BorderThickness="1">
        					<avalonedit:TextEditor x:Name="Field_InnerXml" FontFamily="Courier New" Background="#FF0F172A" Foreground="#FFFFFFFF" ShowLineNumbers="True"/>
        				</Border>
        			</Grid>
        		</DockPanel>
        	</TabItem>
        	<TabItem Header="Userdefined Values">
        		<Grid Background="{DynamicResource Brush_UI_White}">
        			<ListView Margin="0,46.92,0,27" Foreground="#FFE8EEF8" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0"
                            Name="UserdefinedValues_List">
        				<ListView.View>
        					<GridView>
                                <GridViewColumn Header="Key" Width="150" >
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Key}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Written Value" Width="150" >
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Math}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Userdefined Value" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox DropDownOpened="UserdefinedValue_ComboBox_DropDownOpened" IsEditable="True" Text="{Binding UserdefinedValueName}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
        					</GridView>
        				</ListView.View>
        			</ListView>
        			<ToolBar Height="27" VerticalAlignment="Bottom" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0" IsOverflowOpen="False">
        				<Button Click="UserdefinedValues_List_Add_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="UserdefinedValues_List_Add">
        					<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add.png" Stretch="Fill" Width="16"/>
        				</Button>
        				<Button Click="UserdefinedValues_List_Remove_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="UserdefinedValues_List_Remove">
        					<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/delete.png" Stretch="Fill" Width="16"/>
        				</Button>
        			</ToolBar>
        			<Border BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0,0,0,1" VerticalAlignment="Top">
        				<Label >
        					<TextBlock Text="If you wanna use Userdefined Values, you have to create XmlUserdefinedValuesMappers. Click on the Add-Button to create a mapper." TextWrapping="Wrap"/>  				
						</Label>
        			</Border>
        		</Grid>
        	</TabItem>
        </TabControl>
    </Grid>
</UserControl>
