<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="DevelopmentTools.Editors.XmlModule.FilterSystem.FilterEditor"
        Focusable="True" Title="XmlModule Filter Editor" Height="600" Width="800" Icon="/DevelopmentTools;component/Images/Icons/cog.png">
    <Grid>
    	<Menu Height="24" VerticalAlignment="Top" Background="{DynamicResource Brush_UI_White}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush_UI_Border}">
    		<MenuItem Header="File">
    			<MenuItem Header="Save" x:Name="File_Save" Click="File_Save_Click"/>
    			<MenuItem Header="Refresh" x:Name="File_Refresh" Click="File_Refresh_Click"/>
    		</MenuItem>
    	</Menu>
    	<ListView SelectionChanged="Filters_SelectionChanged" x:Name="Filters" HorizontalAlignment="Left" Margin="0,24,0,27" Width="170" Foreground="#FFE8EEF8" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0,0,1,0">
    		<ListView.View>
    			<GridView>
    				<GridView.ColumnHeaderContainerStyle>
    					<Style>
    						<Setter Property="UIElement.Visibility" Value="Collapsed"/>			
						</Style>			
					</GridView.ColumnHeaderContainerStyle>
    				<GridViewColumn DisplayMemberBinding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
    			</GridView>
    		</ListView.View>
    	</ListView>
    	<Grid Margin="170,24,0,0">
    		<Grid Height="21.96" Margin="8,8,8,0" VerticalAlignment="Top">
    			<TextBox TextChanged="filter_TextChanged_UpdateBinding" x:Name="filter_name" Margin="85,0,0,0" TextWrapping="NoWrap" d:LayoutOverrides="Height"/>
    			<TextBlock HorizontalAlignment="Left" Margin="0" TextWrapping="NoWrap" Text="Name" d:LayoutOverrides="Height" VerticalAlignment="Center"/>
    		</Grid>
    		<Grid Height="21.96" Margin="8,33.96,8,0" VerticalAlignment="Top">
                <TextBox TextChanged="filter_TextChanged_UpdateBinding" x:Name="filter_destination" Margin="85,0,0,0" TextWrapping="NoWrap" d:LayoutOverrides="Height"/>
    			<TextBlock HorizontalAlignment="Left" Margin="0" TextWrapping="NoWrap" Text="DestinationFile" d:LayoutOverrides="Height" VerticalAlignment="Center"/>
    		</Grid>
    		<Grid Height="21.96" Margin="8,59.92,8,0" VerticalAlignment="Top">
                <TextBox TextChanged="filter_TextChanged_UpdateBinding" x:Name="filter_selector" Margin="85,0,0,0" TextWrapping="NoWrap" d:LayoutOverrides="Height"/>
    			<TextBlock HorizontalAlignment="Left" Margin="0" TextWrapping="NoWrap" Text="Selector" d:LayoutOverrides="Height" VerticalAlignment="Center"/>
    		</Grid>
    		<Grid Height="21.96" Margin="8,85.88,8,0" VerticalAlignment="Top">
                <TextBox TextChanged="filter_TextChanged_UpdateBinding" x:Name="filter_deselector" Margin="85,0,0,0" TextWrapping="NoWrap" d:LayoutOverrides="Height"/>
    			<TextBlock HorizontalAlignment="Left" Margin="0" TextWrapping="NoWrap" Text="Deselector" d:LayoutOverrides="Height" VerticalAlignment="Center"/>
    		</Grid>
    		<Grid Height="150" Margin="8,111.84,8,0" VerticalAlignment="Top">
                <TextBlock HorizontalAlignment="Left" Margin="0,4,0,0" TextWrapping="NoWrap" Text="Def. Replace" d:LayoutOverrides="Height" VerticalAlignment="Top"/>
    			<ListView x:Name="filter_list_defaultreplace" Margin="85,0,0,25" BorderThickness="1,1,1,0" Foreground="#FFE8EEF8" BorderBrush="{DynamicResource Brush_UI_Border}">
    				<ListView.View>
    					<GridView>
    						<GridView.ColumnHeaderContainerStyle>
    					<Style>
    						<Setter Property="UIElement.Visibility" Value="Visible"/>			
						</Style>			
					</GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="100" Header="Name">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" TextChanged="filter_TextChanged_UpdateBinding"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="300" Header="Key">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Key, Mode=TwoWay}" TextChanged="filter_TextChanged_UpdateBinding"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
    				</ListView.View>
    			</ListView>
    			<ToolBar Height="25" VerticalAlignment="Bottom" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="1,0,1,1" IsOverflowOpen="False" Margin="85,0,0,0">
    				<Button Click="filter_list_defaultreplace_add_Click" x:Name="filter_list_defaultreplace_add" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    					<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add.png" Stretch="Fill" Width="16"/>
    				</Button>
    				<Button Click="filter_list_defaultreplace_delete_Click" x:Name="filter_list_defaultreplace_delete" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    					<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/delete.png" Stretch="Fill" Width="16"/>
    				</Button>
    			</ToolBar>
    		</Grid>
    		<Grid Height="150" Margin="8,265.84,8,0" VerticalAlignment="Top">
    			<TextBlock HorizontalAlignment="Left" Margin="0,4,0,0" TextWrapping="NoWrap" Text="Attributes" d:LayoutOverrides="Height" VerticalAlignment="Top"/>
    			<ListView x:Name="filter_list_attributes" Margin="85,0,0,25" BorderThickness="1,1,1,0" Foreground="#FFE8EEF8" BorderBrush="{DynamicResource Brush_UI_Border}">
    				<ListView.View>
    					<GridView>
    						<GridView.ColumnHeaderContainerStyle>
    							<Style>
    								<Setter Property="UIElement.Visibility" Value="Visible"/>			
    							</Style>			
    						</GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="100" Header="Name">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" TextChanged="filter_TextChanged_UpdateBinding"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="200" Header="Key">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Key, Mode=TwoWay}" TextChanged="filter_TextChanged_UpdateBinding"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>                            
                            <GridViewColumn Width="200" Header="Attribute">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Attribute, Mode=TwoWay}" TextChanged="filter_TextChanged_UpdateBinding"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
    				</ListView.View>
    			</ListView>
    			<ToolBar Height="25" VerticalAlignment="Bottom" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="1,0,1,1" IsOverflowOpen="False" Margin="85,0,0,0">
    				<Button Click="filter_list_attributes_add_Click" x:Name="filter_list_attributes_add" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    					<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add.png" Stretch="Fill" Width="16"/>
    				</Button>
    				<Button Click="filter_list_attributes_delete_Click" x:Name="filter_list_attributes_delete" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    					<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/delete.png" Stretch="Fill" Width="16"/>
    				</Button>
    			</ToolBar>
    		</Grid>
    	</Grid>
    	<ToolBar HorizontalAlignment="Left" Height="27" VerticalAlignment="Bottom" Width="170" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0,0,1,0" IsOverflowOpen="False">
    		<Button Click="button_add_Click" x:Name="button_add" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    			<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add.png" Stretch="Fill" Width="16"/>
    		</Button>
    		<Button Click="button_delete_Click" x:Name="button_delete" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    			<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/delete.png" Stretch="Fill" Width="16"/>
    		</Button>
            <Separator Margin="5,0,5,0"/>
            <Button Click="button_Move_Up_Click" x:Name="button_Move_Up">
                <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/resultset_top.png" Stretch="Fill" Width="16"/>
            </Button>
            <Button Click="button_Move_Down_Click" x:Name="button_Move_Down">
                <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/resultset_bottom.png" Stretch="Fill" Width="16"/>
            </Button>
        </ToolBar>          
    </Grid>
</Window>
