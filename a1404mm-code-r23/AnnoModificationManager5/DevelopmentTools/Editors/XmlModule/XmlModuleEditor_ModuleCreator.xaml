<UserControl x:Class="DevelopmentTools.Editors.XmlModule.XmlModuleEditor_ModuleCreator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:DevelopmentTools.Editors.XmlModule.Controls"
             xmlns:devctrls="clr-namespace:DevelopmentTools.Controls"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="640" Background="{DynamicResource Brush_UI_White}" Focusable="True">
    <Grid>
        <DockPanel x:Name="dockPanel" Margin="0,0,0,27">
            <StackPanel DockPanel.Dock="Top" Margin="14,14,14,4">

                <!-- Template -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Template" Foreground="#FFE8EEF8" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectionChanged="Template_ControlBox_Template_SelectionChanged" x:Name="Template_ControlBox_Template" Foreground="#FFE8EEF8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding ToComboboxHeader}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Click="Template_OpenTemplateEditor_Click" x:Name="Template_OpenTemplateEditor" Width="30" Height="30" Padding="0" Margin="8,0,0,0" ToolTip="Edit template">
                        <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/pencil.png" Stretch="Fill" Width="16" IsHitTestVisible="False"/>
                    </Button>
                </Grid>

                <!-- Template value editor -->
                <ListView KeyUp="Selectors_Selector_KeyUp" x:Name="Template_ValueEditor" Foreground="#FFE8EEF8" Height="125" Margin="0,0,0,8" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="1">
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style>
                                    <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="120" DisplayMemberBinding="{Binding Path=Name}"/>
                            <GridViewColumn Width="{Binding ActualWidth, ConverterParameter=-140, Converter={StaticResource Converters_Arithmetic}, ElementName=Template_ValueEditor}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox TextChanged="Template_TextBox_TextChanged" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Hidden" MaxLines="1" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Source File -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Source File" Foreground="#FFE8EEF8" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" IsEditable="True" x:Name="Files_File" Foreground="#FFE8EEF8" DropDownOpened="Files_File_DropDownOpened"/>
                    <Button Grid.Column="2" Click="Files_File_OpenSelector_Click" x:Name="Files_File_OpenSelector" Width="30" Height="30" Padding="0" Margin="8,0,0,0" Content="..."/>
                </Grid>

                <!-- Selector -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Selector" Foreground="#FFE8EEF8" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" KeyUp="Selectors_Selector_KeyUp" x:Name="Selectors_Selector" MaxLines="1" Height="30" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Click="Selector_Selector_Refresh_Click" x:Name="Selector_Selector_Refresh" Width="30" Height="30" Padding="0" Margin="8,0,0,0" ToolTip="Refresh">
                        <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/arrow_refresh.png" Stretch="Fill" Width="16" IsHitTestVisible="False"/>
                    </Button>
                </Grid>

                <!-- Deselector -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Deselector" Foreground="#FFE8EEF8" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="Selectors_Deselector" MaxLines="1" Height="30" VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>

            <controls:XmlFileTreeview x:Name="XmlEditor" DockPanel.Dock="Bottom" BorderThickness="0"/>
        </DockPanel>

        <Border Height="27" VerticalAlignment="Bottom" Background="{DynamicResource Brush_UI_White}" >
            <Grid>
                <ToolBar Background="{x:Null}" IsOverflowOpen="False" HorizontalAlignment="Left" Width="130">
                    <Button Visibility="Hidden" Click="XmlNode_Add_Click"  x:Name="XmlNode_Add" Margin="3,0,0,0">
                        <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add.png" Stretch="Fill" Width="16"/>
                    </Button>
                    <Button Visibility="Hidden" Click="XmlNode_AddBeforeSelected_Click"  x:Name="XmlNode_AddBeforeSelected"
                            ToolTip="Add before selected item">
                        <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add_new_blue.png" Stretch="Fill" Width="16"/>
                    </Button>
                    <Button Visibility="Hidden" Click="XmlNode_Remove_Click" x:Name="XmlNode_Remove">
                        <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/delete.png" Stretch="Fill" Width="16"/>
                    </Button>
                    <Button Visibility="Hidden" Click="XmlNode_Edit_Click" x:Name="XmlNode_Edit">
                        <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/pencil.png" Stretch="Fill" Width="16"/>
                    </Button>
                    <Button Visibility="Hidden" Click="XmlNode_Select_Click" x:Name="XmlNode_Select">
                        <StackPanel Orientation="Horizontal">
                            <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/cog.png" Stretch="Fill" Width="16"/>
                            <TextBlock Text="Edit Modifier" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Button>
                </ToolBar>
                <DockPanel Margin="130,0,0,0" LastChildFill="False">
                    <ToolBar x:Name="Xml_lastMessage_Inspect_ToolBar" Width="24" Background="{DynamicResource Brush_UI_White}" IsOverflowOpen="False" DockPanel.Dock="Right" Visibility="Collapsed">
                        <Button Click="Xml_lastMessage_Inspect_Click"  x:Name="Xml_lastMessage_Inspect" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/zoom.png" Stretch="Fill" Width="16"/>
                        </Button>
                    </ToolBar>
                    <TextBlock x:Name="Xml_LastCount" VerticalAlignment="Center" Text="0 Elements" TextAlignment="Right" DockPanel.Dock="Right" Margin="0,0,5,0"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
