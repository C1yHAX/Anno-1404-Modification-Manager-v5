<UserControl x:Class="DevelopmentTools.Editors.XmlModule.XmlModuleEditor_ModuleCreator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:DevelopmentTools.Editors.XmlModule.Controls"   
             xmlns:devctrls="clr-namespace:DevelopmentTools.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="640" Background="White" Focusable="True">
    <Grid>
    	<DockPanel x:Name="dockPanel" Margin="0,0,0,27">
    		<Expander Header="Expander" Style="{DynamicResource ExpanderStyle_Headerless}" IsExpanded="True" VerticalAlignment="Top" DockPanel.Dock="Top">
    			<Grid>
    				<Grid Background="White" Height="40" VerticalAlignment="Top">
    					<Grid 
    						Width="{Binding ActualWidth, ConverterParameter=-20, Converter={StaticResource Converters_Arithmetic}, ElementName=dockPanel}"
    						Margin="8,8,8,10.08" HorizontalAlignment="Left" MaxWidth="450">
                            <ComboBox SelectionChanged="Template_ControlBox_Template_SelectionChanged" x:Name="Template_ControlBox_Template" Margin="82,0,26,0" d:LayoutOverrides="Height" Background="{DynamicResource Brush_UI_White}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding ToComboboxHeader}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                                <Button Click="Template_OpenTemplateEditor_Click" x:Name="Template_OpenTemplateEditor" HorizontalAlignment="Right" Width="22" d:LayoutOverrides="Height" Background="{DynamicResource Brush_UI_White}">
    							<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/pencil.png" Stretch="Fill" Width="16" IsHitTestVisible="False"/>
    						</Button>
    						<Grid HorizontalAlignment="Left" Width="82">
    							<TextBlock TextWrapping="NoWrap" d:LayoutOverrides="Width, Height" VerticalAlignment="Center" HorizontalAlignment="Left"><Run Language="de-de" Text="Template"/></TextBlock>
    						</Grid>
    					</Grid>
    				</Grid>
    				<ListView KeyUp="Selectors_Selector_KeyUp" x:Name="Template_ValueEditor" VerticalAlignment="Top" Foreground="Black" Margin="0,40,0,0" Height="125" BorderBrush="{x:Null}" BorderThickness="0">
    					<ListView.View>
    						<GridView>
    							<GridView.ColumnHeaderContainerStyle>
    								<Style>
    									<Setter Property="UIElement.Visibility" Value="Collapsed"/>			
									</Style>			
								</GridView.ColumnHeaderContainerStyle>
    							<GridViewColumn Width="82" DisplayMemberBinding="{Binding Path=Name}"/>
                                <GridViewColumn Width="{Binding ActualWidth, ElementName=File_DestinationFile}">
									<GridViewColumn.CellTemplate>
										<DataTemplate>
											<TextBox TextChanged="Template_TextBox_TextChanged" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Hidden" MaxLines="1" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
										</DataTemplate>
									</GridViewColumn.CellTemplate>
								</GridViewColumn>
    						</GridView>
    					</ListView.View>
    				</ListView>
    			</Grid>
    		</Expander>
    		<Expander Header="Expander" Style="{DynamicResource ExpanderStyle_Headerless}" IsExpanded="True" VerticalAlignment="Top" DockPanel.Dock="Top">
    			<Grid Height="40" Background="White">
                    <Grid Width="{Binding ElementName=dockPanel, Path=ActualWidth,
                      Converter={StaticResource Converters_Arithmetic},
                      ConverterParameter=-20}" Height="21.96" Margin="8,8,8,0" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="600">
    					<ComboBox IsEditable="True" x:Name="Files_File" Margin="82,0,26,0" d:LayoutOverrides="Height"
                                DropDownOpened="Files_File_DropDownOpened" />
    					<Grid HorizontalAlignment="Left" Width="82">
                            <TextBlock TextWrapping="NoWrap" d:LayoutOverrides="Width, Height" VerticalAlignment="Center" HorizontalAlignment="Left" Text="Source File" />
                        </Grid>
    					<Button Click="Files_File_OpenSelector_Click" x:Name="Files_File_OpenSelector" HorizontalAlignment="Right" Width="22" Background="{DynamicResource Brush_UI_White}" d:LayoutOverrides="Height" Content="..."/>
    				</Grid>                   
    			</Grid>
    		</Expander>
    		<Expander Header="Expander" Style="{DynamicResource ExpanderStyle_Headerless}" IsExpanded="True" VerticalAlignment="Top" DockPanel.Dock="Top">
    			<Grid Height="65" Background="White">
                    <Grid Width="{Binding ElementName=dockPanel, Path=ActualWidth,
                      Converter={StaticResource Converters_Arithmetic},
                      ConverterParameter=-20}" Height="21.96" Margin="8,8,8,0" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="600">
    					<TextBox KeyUp="Selectors_Selector_KeyUp" x:Name="Selectors_Selector" Margin="82,0,26,0" d:LayoutOverrides="Height" MaxLines="1"/>
    					<Grid HorizontalAlignment="Left" Width="82">
    						<TextBlock TextWrapping="NoWrap" d:LayoutOverrides="Width, Height" VerticalAlignment="Center" HorizontalAlignment="Left" Text="Selector"/>
    					</Grid>
    					<Button Click="Selector_Selector_Refresh_Click" x:Name="Selector_Selector_Refresh" HorizontalAlignment="Right" Width="22" Background="{DynamicResource Brush_UI_White}" d:LayoutOverrides="Height">
    						<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/arrow_refresh.png" Stretch="Fill" Width="16" IsHitTestVisible="False"/>
    					</Button>
    				</Grid>
                    <Grid Width="{Binding ElementName=dockPanel, Path=ActualWidth,
                      Converter={StaticResource Converters_Arithmetic},
                      ConverterParameter=-20}" Height="21.96" Margin="8,33.96,8,0" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="600">
    					<TextBox x:Name="Selectors_Deselector" Margin="82,0,0,0" d:LayoutOverrides="Height" MaxLines="1"/>
    					<Grid HorizontalAlignment="Left" Width="82">
    						<TextBlock TextWrapping="NoWrap" d:LayoutOverrides="Width, Height" VerticalAlignment="Center" HorizontalAlignment="Left" Text="Deselector"/>
    					</Grid>
    				</Grid>
    			</Grid>
    		</Expander>
    		<controls:XmlFileTreeview x:Name="XmlEditor" DockPanel.Dock="Bottom" BorderThickness="0"/>
    	</DockPanel>
    	<Border Height="27" VerticalAlignment="Bottom" Background="{DynamicResource Brush_UI_White}" >
    		<Grid>
    			<ToolBar Background="{x:Null}" IsOverflowOpen="False" HorizontalAlignment="Left" Width="130">
                    <Button Visibility="Hidden" Click="XmlNode_Add_Click"  x:Name="XmlNode_Add" Margin="3,0,0,0">
    					<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add.png" Stretch="Fill" Width="16"/>
                    </Button>
                    <Button Visibility="Hidden" Click="XmlNode_AddBeforeSelected_Click"  x:Name="XmlNode_AddBeforeSelected" 
                            ToolTip="Add before selected item">
                        <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add_new_blue.png" Stretch="Fill" Width="16"/>
                    </Button>
                    <Button Visibility="Hidden" Click="XmlNode_Remove_Click" x:Name="XmlNode_Remove">
    					<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/delete.png" Stretch="Fill" Width="16"/>    			 		
    				</Button>
                    <Button Visibility="Hidden" Click="XmlNode_Edit_Click" x:Name="XmlNode_Edit">
    					<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/pencil.png" Stretch="Fill" Width="16"/>
    				</Button>
                    <Button Visibility="Hidden" Click="XmlNode_Select_Click" x:Name="XmlNode_Select">
                        <StackPanel Orientation="Horizontal">
                            <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/cog.png" Stretch="Fill" Width="16"/>
                            <TextBlock Text="Edit Modifier" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Button>
                </ToolBar>
    			<DockPanel Margin="130,0,0,0" LastChildFill="False">
    				<ToolBar x:Name="Xml_lastMessage_Inspect_ToolBar" Width="24" Background="{DynamicResource Brush_UI_White}" IsOverflowOpen="False" DockPanel.Dock="Right" Visibility="Collapsed">
                        <Button Click="Xml_lastMessage_Inspect_Click"  x:Name="Xml_lastMessage_Inspect" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Image Height="16" Source="/DevelopmentTools;component/Images/Icons/zoom.png" Stretch="Fill" Width="16"/>
                        </Button>
                    </ToolBar>
    				<TextBlock x:Name="Xml_LastCount" VerticalAlignment="Center" Text="0 Elements" TextAlignment="Right" DockPanel.Dock="Right" Margin="0,0,5,0"/>
    			</DockPanel>
    		</Grid>
    	</Border>
    </Grid>
</UserControl>
