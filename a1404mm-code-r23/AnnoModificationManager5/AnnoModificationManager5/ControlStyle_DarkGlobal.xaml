<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Window">
        <Setter Property="Background" Value="#FF0C2036"/>
        <Setter Property="Foreground" Value="#FFEAF1F9"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
        <Setter Property="BorderBrush" Value="#FF33455F"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FF12223A"/>
        <Setter Property="Foreground" Value="#FFF2F6FB"/>
        <Setter Property="BorderBrush" Value="#FF33455F"/>
        <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
    </Style>

</ResourceDictionary>
