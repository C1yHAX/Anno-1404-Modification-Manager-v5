<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Window">
        <Setter Property="Background" Value="#FF0C2036"/>
        <Setter Property="Foreground" Value="#FFE7EFF8"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
        <Setter Property="BorderBrush" Value="#FF33455F"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FF12223A"/>
        <Setter Property="Foreground" Value="#FFF2F6FB"/>
        <Setter Property="BorderBrush" Value="#FF33455F"/>
        <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="#FFEAF1F9"/>
        <Setter Property="Background" Value="#FF1B2C42"/>
        <Setter Property="BorderBrush" Value="#FF33455F"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FF26405F"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#FF31507A"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#FF33455F"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#FFCFE0F0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="b" Background="#FF152740" BorderBrush="#FF33455F" BorderThickness="1,1,1,0" CornerRadius="7,7,0,0" Margin="2,0,0,0" Padding="14,7">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FF1C3552"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF22426B"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="#FF12223A"/>
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
        <Setter Property="BorderBrush" Value="#FF33455F"/>
    </Style>
    <Style TargetType="ListView">
        <Setter Property="Background" Value="#FF12223A"/>
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
        <Setter Property="BorderBrush" Value="#FF33455F"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14FFFFFF"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#335B6CF0"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="#FFE3ECF6"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="#FFEAF1F9"/>
        <Setter Property="Background" Value="#FF12223A"/>
        <Setter Property="BorderBrush" Value="#FF33455F"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="#FF33455F" BorderThickness="1" CornerRadius="6">
                                        <Path Data="M0,0 L4,4 L8,0 Z" Fill="#FF9DB2C8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="10,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                          TextElement.Foreground="#FFEAF1F9"/>
                        <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="#FF15263B" BorderBrush="#FF33455F" BorderThickness="1" CornerRadius="6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Margin="0,2,0,0">
                                <ScrollViewer><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#FFEAF1F9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#335B6CF0"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
