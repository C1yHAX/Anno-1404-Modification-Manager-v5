<UserControl x:Class="AnnoModificationManager5.MainControls.ModificationList.ModificationListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lng="clr-namespace:AnnoModificationManager5.Language.DictionarySystem"        
             xmlns:ui_grp="clr-namespace:AnnoModificationManager5.UserInterface.Group"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="640" Background="White">
    <UserControl.Resources>
        <CollectionViewSource x:Key="List_All_ViewSource">
            <CollectionViewSource.GroupDescriptions>
                <ui_grp:ModificationGroupDescription/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="List_Retail_ViewSource">
            <CollectionViewSource.GroupDescriptions>
                <ui_grp:ModificationGroupDescription/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="List_Addon_ViewSource">
            <CollectionViewSource.GroupDescriptions>
                <ui_grp:ModificationGroupDescription/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="List_IAAM_ViewSource">
            <CollectionViewSource.GroupDescriptions>
                <ui_grp:ModificationGroupDescription/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    	<StackPanel VerticalAlignment="Top">
            <Expander Margin="0,10,0,0" Style="{DynamicResource ExpanderStyle_Small}" IsExpanded="True" Name="Expander_Loading" Visibility="Collapsed">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Height="40" Source="/AnnoModificationManager5;component/Images/Logo/Version3_Comet256.ico" Width="40" Stretch="Fill"/>
                        <TextBlock Text="{lng:LanguageMarkup Dictionary=MainUI,Key=ModificationList_Loading}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Expander.Header>
                <ListView x:Name="list_Loading" Margin="80,0,0,0" Foreground="Black" BorderBrush="{x:Null}" BorderThickness="0" Style="{DynamicResource ListViewStyle_NoScroll}">                     
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style>
                                    <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding UICollector.Icon}" Width="16" Height="16"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120" x:Name="list_Loading_Column_Category">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.Category}" Foreground="Gray"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="250" DisplayMemberBinding="{Binding UICollector.Name}"/>
                            <GridViewColumn Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.VersionString}" Foreground="Gray"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="200" x:Name="list_Loading_Column_Author">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{lng:LanguageMarkup Dictionary=MainUI, Key=ModificationList_AuthorLabel}" Foreground="Gray"/>
                                            <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.Author}" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Expander>
            <Expander Margin="0,10,0,0" Style="{DynamicResource ExpanderStyle_Small}" IsExpanded="True" Name="Expander_All" Visibility="Collapsed">
    			<Expander.Header>
    				<StackPanel Orientation="Horizontal">
    					<Image Height="40" Source="/AnnoModificationManager5;component/Images/AMM4_Icon_50.png" Width="40" Stretch="Fill"/>
                        <TextBlock Text="{lng:LanguageMarkup Dictionary=MainUI,Key=ModificationList_AllVersions}" VerticalAlignment="Center" Margin="5,0,0,0"/>
    				</StackPanel>
    			</Expander.Header>
                <ListView Style="{DynamicResource ListViewStyle_NoScroll}" SelectionChanged="list_AllVersions_SelectionChanged" ItemsSource="{Binding Source={StaticResource List_All_ViewSource}}" x:Name="list_AllVersions" Margin="80,0,0,0" Foreground="Black" BorderBrush="{x:Null}" BorderThickness="0">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" Header="{Binding Path=Name}" Style="{DynamicResource ExpanderStyle_Small}">
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style>
                                    <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding UICollector.Icon}" Width="16" Height="16"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120" x:Name="list_All_Column_Category">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.Category}" Foreground="Gray"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>                          
                            <GridViewColumn Width="250" DisplayMemberBinding="{Binding UICollector.Name}"/>
                            <GridViewColumn Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.VersionString}" Foreground="Gray"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="200" x:Name="list_All_Column_Author">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{lng:LanguageMarkup Dictionary=MainUI, Key=ModificationList_AuthorLabel}" Foreground="Gray"/>
                                            <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.Author}" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>                              
                        </GridView>
                    </ListView.View>
                </ListView>
    		</Expander>
    		<Expander Style="{DynamicResource ExpanderStyle_Small}" IsExpanded="True" Margin="0,10,0,0" Name="Expander_Retail" Visibility="Collapsed">
    			<Expander.Header>
    				<StackPanel Orientation="Horizontal">
    					<Image Height="40" Source="/AnnoModificationManager5;component/Images/Icon_Retail_50.png" Width="40" Stretch="Fill"/>
                        <TextBlock Text="{lng:LanguageMarkup Dictionary=MainUI,Key=ModificationList_Retail}" VerticalAlignment="Center" Margin="5,0,0,0"/>
    				</StackPanel>
    			</Expander.Header>
                <ListView Style="{DynamicResource ListViewStyle_NoScroll}" SelectionChanged="list_Retail_SelectionChanged" ItemsSource="{Binding Source={StaticResource List_Retail_ViewSource}}" x:Name="list_Retail" Margin="80,0,0,0" Foreground="Black" BorderBrush="{x:Null}" BorderThickness="0" d:LayoutOverrides="Width, Height">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" Header="{Binding Path=Name}" Style="{DynamicResource ExpanderStyle_Small}">
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style>
                                    <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding UICollector.Icon}" Width="16" Height="16"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120" x:Name="list_Retail_Column_Category">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.Category}" Foreground="Gray"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="250" DisplayMemberBinding="{Binding UICollector.Name}"/>
                            <GridViewColumn Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.VersionString}" Foreground="Gray"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="200" x:Name="list_Retail_Column_Author">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{lng:LanguageMarkup Dictionary=MainUI, Key=ModificationList_AuthorLabel}" Foreground="Gray"/>
                                            <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.Author}" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>    			
    		</Expander>
            <Expander Style="{DynamicResource ExpanderStyle_Small}" IsExpanded="True" Margin="0,10,0,0" Name="Expander_Addon" Visibility="Collapsed">
    			<Expander.Header>
    				<StackPanel Orientation="Horizontal">
    					<Image Height="40" Source="/AnnoModificationManager5;component/Images/Icon_Addon_50.png" Width="40" Stretch="Fill"/>
                        <TextBlock Text="{lng:LanguageMarkup Dictionary=MainUI,Key=ModificationList_Addon}" VerticalAlignment="Center" Margin="5,0,0,0"/>
    				</StackPanel>
    			</Expander.Header>
                <ListView Style="{DynamicResource ListViewStyle_NoScroll}" SelectionChanged="list_Addon_SelectionChanged" ItemsSource="{Binding Source={StaticResource List_Addon_ViewSource}}" x:Name="list_Addon"  Margin="80,0,0,0" Foreground="Black" BorderBrush="{x:Null}" BorderThickness="0" d:LayoutOverrides="Width, Height">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" Header="{Binding Path=Name}" Style="{DynamicResource ExpanderStyle_Small}">
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style>
                                    <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding UICollector.Icon}" Width="16" Height="16"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120" x:Name="list_Addon_Column_Category">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.Category}" Foreground="Gray"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="250" DisplayMemberBinding="{Binding UICollector.Name}"/>
                            <GridViewColumn Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.VersionString}" Foreground="Gray"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="200" x:Name="list_Addon_Column_Author">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{lng:LanguageMarkup Dictionary=MainUI, Key=ModificationList_AuthorLabel}" Foreground="Gray"/>
                                            <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.Author}" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>    			
    		</Expander>
            <Expander Style="{DynamicResource ExpanderStyle_Small}" IsExpanded="True" Margin="0,10,0,0" Name="Expander_IAAM" Visibility="Collapsed">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Height="40" Source="/AnnoModificationManager5;component/Images/Icon_IAAM_50.png" Width="40" Stretch="Fill"/>
                        <TextBlock Text="{lng:LanguageMarkup Dictionary=MainUI,Key=ModificationList_IAAM}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Expander.Header>
                <ListView Style="{DynamicResource ListViewStyle_NoScroll}" SelectionChanged="list_IAAM_SelectionChanged" ItemsSource="{Binding Source={StaticResource List_IAAM_ViewSource}}" x:Name="list_IAAM"  Margin="80,0,0,0" Foreground="Black" BorderBrush="{x:Null}" BorderThickness="0" d:LayoutOverrides="Width, Height">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" Header="{Binding Path=Name}" Style="{DynamicResource ExpanderStyle_Small}">
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style>
                                    <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding UICollector.Icon}" Width="16" Height="16"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120" x:Name="list_IAAM_Column_Category">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.Category}" Foreground="Gray"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="250" DisplayMemberBinding="{Binding UICollector.Name}"/>
                            <GridViewColumn Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.VersionString}" Foreground="Gray"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="200" x:Name="list_IAAM_Column_Author">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{lng:LanguageMarkup Dictionary=MainUI, Key=ModificationList_AuthorLabel}" Foreground="Gray"/>
                                            <TextBlock Margin="0,0,0,0" Text="{Binding UICollector.Author}" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
