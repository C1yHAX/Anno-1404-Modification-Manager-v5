<Window x:Class="AnnoModificationManager5.UserInterface.Modern.ModernMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mainui="clr-namespace:AnnoModificationManager5.UserInterface.MainUI"
        xmlns:lng="clr-namespace:AnnoModificationManager5.Language.DictionarySystem"
        Title="Anno 1404 Mod Manager" Height="640" Width="1180" MinHeight="520" MinWidth="940" Style="{x:Null}"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#0C2036" FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0C2036" Offset="0"/>
            <GradientStop Color="#13314E" Offset="0.55"/>
            <GradientStop Color="#1B4A6E" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Sidebar" Color="#0A1A2B"/>
        <SolidColorBrush x:Key="Card" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="TextMain" Color="#F2F6FB"/>
        <SolidColorBrush x:Key="TextDim" Color="#9DB2C8"/>
        <SolidColorBrush x:Key="Green" Color="#3ECF8E"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#225B6CF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#FF0C2036">
        <Image Source="pack://application:,,,/Images/Background/harbor.png" Stretch="UniformToFill" IsHitTestVisible="False"/>
        <Grid IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                    <GradientStop Color="#F50A1A2B" Offset="0.0"/>
                    <GradientStop Color="#E00B1E32" Offset="0.32"/>
                    <GradientStop Color="#9A0C2036" Offset="0.66"/>
                    <GradientStop Color="#5E0C2036" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource Sidebar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="22,24,0,18">
                        <TextBlock Text="ANNO" Foreground="#FFEAC36B" FontFamily="Georgia" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="1404" Foreground="#FFEAC36B" FontFamily="Georgia" FontSize="30" FontWeight="Bold" Margin="0,-8,0,0"/>
                        <TextBlock Text="MOD MANAGER" Foreground="#FFC9A24A" FontSize="11" FontWeight="SemiBold" Margin="2,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <Button x:Name="nav_Overview" Style="{StaticResource NavButton}" Click="nav_Overview_Click" Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Nav_Overview}" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="nav_Mods" Style="{StaticResource NavButton}" Click="nav_Mods_Click" Content="🧩   Mods"/>
                        <Button x:Name="nav_Categories" Style="{StaticResource NavButton}" Click="nav_Categories_Click" Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Nav_Categories}"/>
                        <Button x:Name="nav_Settings" Style="{StaticResource NavButton}" Click="nav_Settings_Click" Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Nav_Settings}"/>
                        <Button x:Name="nav_Restore" Style="{StaticResource NavButton}" Click="nav_Restore_Click" Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Nav_Restore}"/>
                        <Button x:Name="nav_About" Style="{StaticResource NavButton}" Click="nav_About_Click" Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Nav_About}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="22,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                            <StackPanel Margin="9,0,0,0">
                                <TextBlock Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=GameFound}" Foreground="{StaticResource TextDim}" FontSize="11"/>
                                <TextBlock x:Name="lbl_Game" Text="Anno 1404" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="lbl_SideVersion" Text="v5.0.2.0" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Caption -->
                <Grid Grid.Row="0">
                    <TextBlock x:Name="lbl_Title" Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=Title_Overview}" Foreground="{StaticResource TextMain}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="26,0,0,0"/>
                    <Border Width="300" Height="36" HorizontalAlignment="Right" Margin="0,0,140,0" VerticalAlignment="Center"
                            Background="#14FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="9"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <TextBlock Text="🔎" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="11,0,0,0" FontSize="13"/>
                            <TextBox x:Name="txt_Search" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}"
                                     VerticalContentAlignment="Center" Margin="34,0,10,0" CaretBrush="White" TextChanged="txt_Search_TextChanged"/>
                            <TextBlock x:Name="lbl_SearchHint" Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=SearchHint}" Foreground="{StaticResource TextDim}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="34,0,0,0"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WinBtn}" Content="—" Click="Min_Click"/>
                        <Button x:Name="btn_Max" Style="{StaticResource WinBtn}" Content="□" Click="Max_Click"/>
                        <Button Style="{StaticResource WinBtn}" Content="✕" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="26,4,26,22">

                    <!-- RESTORE -->
                    <Grid x:Name="view_Restore" Visibility="Collapsed">
                        <mainui:RestoreManager x:Name="restoreView"/>
                    </Grid>

                    <!-- OVERVIEW -->
                    <Grid x:Name="view_Overview">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=Overview_InstalledVersion}" Foreground="{StaticResource TextDim}" FontSize="13" Margin="2,0,0,8"/>
                        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="lbl_ModName" Text="—" Foreground="{StaticResource TextMain}" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="lbl_ModMeta" Text="" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="#1E3ECF8E" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="✓" Foreground="{StaticResource Green}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="2" Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Overview_ManageMods}" VerticalAlignment="Center" Height="38" Padding="16,0" Foreground="White" Cursor="Hand" Click="nav_Mods_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#5B6CF0" Offset="0"/>
                                                        <GradientStop Color="#7A5BF0" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="2" Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=Overview_Categories}" Foreground="{StaticResource TextDim}" FontSize="13" Margin="2,0,0,8"/>
                        <ItemsControl Grid.Row="3" x:Name="ic_Categories" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Cursor="Hand" Click="Category_Click" Tag="{Binding Title}" Margin="0,0,16,0" Height="156" VerticalAlignment="Top">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" CornerRadius="12,12,0,0">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#264E80" Offset="0"/>
                                                                    <GradientStop Color="#16314E" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Image Source="{Binding IconPath}" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Row="1" Margin="16,10,16,14">
                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <Grid Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                                                                <Border HorizontalAlignment="Right" Background="#1A5B6CF0" CornerRadius="8" Padding="9,3">
                                                                    <TextBlock Text="{Binding CountText}" Foreground="#AFC0FF" FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#5B6CF0"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- MODS -->
                    <Grid x:Name="view_Mods" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                            <Button x:Name="btn_Apply" Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Apply}" Click="Apply_Click" Cursor="Hand" Height="36" Padding="16,0" Foreground="White" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ab" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2E9E6B" Offset="0"/><GradientStop Color="#3ECF8E" Offset="1"/></LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ab" Property="Opacity" Value="0.9"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=AddMod}" Style="{StaticResource Pill}" Click="AddMod_Click" Margin="0,0,8,0"/>
                            <Button Content="🟧  Nexus Mods" Style="{StaticResource Pill}" Click="Nexus_Click" Margin="0,0,8,0"/>
                            <Button Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=GitHubBrowser}" Style="{StaticResource Pill}" Click="GitHub_Click" Margin="0,0,8,0"/>
                            <Button Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Refresh}" Style="{StaticResource Pill}" Click="Refresh_Click"/>
                            <TextBlock x:Name="lbl_Filter" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Margin="0,0,16,0">
                                <ListBox x:Name="lst_Mods" Background="Transparent" BorderThickness="0" Margin="6"
                                         ItemContainerStyle="{StaticResource ModItem}" SelectionChanged="lst_Mods_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Meta}" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12">
                                <Grid Margin="22,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock x:Name="d_Name" Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=NoModSelected}" Foreground="{StaticResource TextMain}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock x:Name="d_Meta" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                            <Border x:Name="d_StatusChip" CornerRadius="8" Padding="9,2" Margin="12,0,0,0" Background="#1A9DB2C8" Visibility="Collapsed">
                                                <TextBlock x:Name="d_Status" Foreground="{StaticResource TextMain}" FontSize="11"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Row="1" Height="1" Background="#1AFFFFFF" Margin="0,16"/>
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="d_Desc" Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button x:Name="btn_Activate" Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Activate}" Style="{StaticResource Pill}" Margin="0,0,10,0" Click="Activate_Click"/>
                                        <Button x:Name="btn_Deactivate" Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Deactivate}" Style="{StaticResource Pill}" Margin="0,0,10,0" Click="Deactivate_Click" Visibility="Collapsed"/>
                                        <Button Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Information}" Style="{StaticResource Pill}" Margin="0,0,10,0" Click="Info_Click"/>
                                        <Button Content="🌐  Website" Style="{StaticResource Pill}" Margin="0,0,10,0" Click="Website_Click"/>
                                        <Button Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Delete}" Style="{StaticResource Pill}" Click="Uninstall_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- CATEGORIES -->
                    <Grid x:Name="view_Categories" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=Categories_Hint}" Foreground="{StaticResource TextDim}" FontSize="13" Margin="2,0,0,10"/>
                        <ItemsControl Grid.Row="1" x:Name="ic_CategoriesFull" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Cursor="Hand" Click="Category_Click" Tag="{Binding Title}" Width="240" Height="150" Margin="0,0,16,16" VerticalAlignment="Top">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" CornerRadius="12,12,0,0">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#264E80" Offset="0"/>
                                                                    <GradientStop Color="#16314E" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Image Source="{Binding IconPath}" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Row="1" Margin="16,10,16,14">
                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <Grid Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                                                                <Border HorizontalAlignment="Right" Background="#1A5B6CF0" CornerRadius="8" Padding="9,3">
                                                                    <TextBlock Text="{Binding CountText}" Foreground="#AFC0FF" FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#5B6CF0"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- ABOUT -->
                    <Grid x:Name="view_About" Visibility="Collapsed">
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="30" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Anno 1404 Modification Manager" Foreground="{StaticResource TextMain}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock x:Name="lbl_Version" Text="Version 5.0" Foreground="{StaticResource Green}" FontSize="14" Margin="0,4,0,0"/>
                                <TextBlock Margin="0,16,0,0" Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap"
                                           Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=About_Text}"/>
                                <TextBlock Margin="0,18,0,6" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" Text="Links"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🌐  GitHub" Style="{StaticResource Pill}" Margin="0,0,10,0" Click="LinkGitHub_Click"/>
                                    <Button Content="🟧  Nexus Mods" Style="{StaticResource Pill}" Click="LinkNexus_Click"/>
                                </StackPanel>
                                <TextBlock Margin="0,20,0,0" Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap"
                                           Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=About_Footer}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- SETTINGS -->
                    <Grid x:Name="view_Settings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_Language}" Foreground="{StaticResource TextDim}" FontSize="13" Margin="2,0,0,8"/>
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,18">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="set_LangDe" GroupName="setlang" Content="Deutsch" Foreground="{StaticResource TextMain}"/>
                                        <RadioButton x:Name="set_LangEn" GroupName="setlang" Content="English" Foreground="{StaticResource TextMain}" Margin="24,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_GameFolder}" Foreground="{StaticResource TextDim}" FontSize="13" Margin="2,0,0,8"/>
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock x:Name="set_AnnoDir" Foreground="{StaticResource TextMain}" FontSize="13" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_ChooseOther}" Style="{StaticResource Pill}" Click="Set_ChooseAnno_Click"/>
                                            <Button Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_AutoDetect}" Style="{StaticResource Pill}" Margin="8,0,0,0" Click="Set_AutoAnno_Click"/>
                                        </StackPanel>
                                        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_GameFolderHint}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_DataFolder}" Foreground="{StaticResource TextDim}" FontSize="13" Margin="2,0,0,8"/>
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock x:Name="set_DataDir" Foreground="{StaticResource TextMain}" FontSize="13" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_ChooseFolder}" Style="{StaticResource Pill}" Click="Set_ChooseData_Click"/>
                                            <Button Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_Default}" Style="{StaticResource Pill}" Margin="8,0,0,0" Click="Set_StandardData_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Anno 1404 – Version" Foreground="{StaticResource TextDim}" FontSize="13" Margin="2,0,0,8"/>
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <ComboBox x:Name="set_Version" Width="300" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="set_VersionAuto" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,8,0,0"/>
                                        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_VersionHint}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_BackupLocation}" Foreground="{StaticResource TextDim}" FontSize="13" Margin="2,0,0,8"/>
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock x:Name="set_BackupDir" Foreground="{StaticResource TextMain}" FontSize="13" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_ChooseFolder}" Style="{StaticResource Pill}" Click="Set_ChooseBackup_Click"/>
                                        </StackPanel>
                                        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_BackupHint}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Updates" Foreground="{StaticResource TextDim}" FontSize="13" Margin="2,0,0,8"/>
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock x:Name="set_UpdateInfo" Foreground="{StaticResource TextMain}" FontSize="13" Text="Installierte Version: 5.0.2.0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_CheckUpdates}" Style="{StaticResource Pill}" Click="Set_CheckUpdates_Click"/>
                                            <Button x:Name="set_InstallUpdate" Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_InstallUpdate}" Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="Collapsed" Click="Set_InstallUpdate_Click"/>
                                            <Button x:Name="set_OpenRelease" Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_OpenDownload}" Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="Collapsed" Click="Set_OpenRelease_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="set_UpdateStatus" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{lng:LanguageMarkup Dictionary=ModernUI, Key=Set_SaveRestart}" Style="{StaticResource Pill}" Click="Set_Save_Click"/>
                                    <TextBlock x:Name="set_Status" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
        <Border x:Name="dimOverlay" Background="#A6000000" Visibility="Collapsed"/>
    </Grid>
</Window>
