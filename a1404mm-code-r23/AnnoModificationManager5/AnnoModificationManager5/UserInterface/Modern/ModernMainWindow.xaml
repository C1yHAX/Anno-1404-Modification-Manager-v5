<Window x:Class="AnnoModificationManager5.UserInterface.Modern.ModernMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anno 1404 Mod Manager" Height="470" Width="1170"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0C2036" Offset="0"/>
            <GradientStop Color="#13314E" Offset="0.55"/>
            <GradientStop Color="#1B4A6E" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="Sidebar" Color="#0A1A2B"/>
        <SolidColorBrush x:Key="Card" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="TextMain" Color="#F2F6FB"/>
        <SolidColorBrush x:Key="TextDim" Color="#9DB2C8"/>
        <SolidColorBrush x:Key="Accent" Color="#5B6CF0"/>
        <SolidColorBrush x:Key="Green" Color="#3ECF8E"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource Bg}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource Sidebar}" CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="22,26,0,18">
                        <TextBlock Text="ANNO" Foreground="{StaticResource Green}" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="1404" Foreground="#E7B84a" FontSize="26" FontWeight="Bold" Margin="0,-6,0,0"/>
                        <TextBlock Text="MOD MANAGER" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="SemiBold" Margin="2,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <Button x:Name="nav_Overview" Style="{StaticResource NavButton}" Click="nav_Overview_Click" Content="🏠   Übersicht"/>
                        <Button x:Name="nav_Mods" Style="{StaticResource NavButton}" Click="nav_Mods_Click" Content="🧩   Mods"/>
                        <Button x:Name="nav_Categories" Style="{StaticResource NavButton}" Click="nav_Categories_Click" Content="🗂   Kategorien"/>
                        <Button x:Name="nav_Settings" Style="{StaticResource NavButton}" Click="nav_Settings_Click" Content="⚙   Einstellungen"/>
                        <Button x:Name="nav_About" Style="{StaticResource NavButton}" Click="nav_About_Click" Content="ⓘ   Über"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="22,0,0,22">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                        <StackPanel Margin="9,0,0,0">
                            <TextBlock Text="Spiel erkannt" Foreground="{StaticResource TextDim}" FontSize="11"/>
                            <TextBlock x:Name="lbl_Game" Text="Anno 1404" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main -->
            <Grid Grid.Column="1" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Height="64" MouseLeftButtonDown="TitleBar_MouseDown">
                    <TextBlock x:Name="lbl_Title" Text="Übersicht" Foreground="{StaticResource TextMain}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="26,0,0,0"/>

                    <Border Width="320" Height="38" HorizontalAlignment="Right" Margin="0,0,120,0" VerticalAlignment="Center"
                            Background="#14FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <TextBox x:Name="txt_Search" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}"
                                     VerticalContentAlignment="Center" Margin="34,0,10,0" CaretBrush="White" TextChanged="txt_Search_TextChanged"/>
                            <TextBlock Text="🔎" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="11,0,0,0" FontSize="13"/>
                            <TextBlock x:Name="lbl_SearchHint" Text="Mods suchen…" Foreground="{StaticResource TextDim}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="34,0,0,0"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0">
                        <Button Content="—" Click="Min_Click" Width="38" Height="30" Foreground="{StaticResource TextDim}" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14"/>
                        <Button Content="✕" Click="Close_Click" Width="38" Height="30" Foreground="{StaticResource TextDim}" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="26,0,26,0">
                    <!-- Overview view -->
                    <Grid x:Name="view_Overview">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Installierte Version" Foreground="{StaticResource TextDim}" FontSize="13" Margin="2,0,0,8"/>
                        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="lbl_ModName" Text="—" Foreground="{StaticResource TextMain}" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="lbl_ModMeta" Text="" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="#1E3ECF8E" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="✓" Foreground="{StaticResource Green}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="2" Content="↻  Nach Updates suchen" VerticalAlignment="Center" Height="38" Padding="16,0"
                                        Foreground="White" Cursor="Hand" Click="Updates_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#5B6CF0" Offset="0"/>
                                                        <GradientStop Color="#7A5BF0" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Mod-Kategorien" Foreground="{StaticResource TextDim}" FontSize="13" VerticalAlignment="Bottom" Margin="2,0,0,2" Visibility="Collapsed"/>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Mod-Kategorien" Foreground="{StaticResource TextDim}" FontSize="13" Margin="2,0,0,8"/>
                            <ItemsControl x:Name="ic_Categories">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Margin="0,0,16,0" Height="150">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#1FFFFFFF">
                                                    <TextBlock Text="{Binding Glyph}" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="16,10,16,14">
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold"/>
                                                    <Grid Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                                                        <Border HorizontalAlignment="Right" Background="#1A5B6CF0" CornerRadius="8" Padding="9,3">
                                                            <TextBlock Text="{Binding CountText}" Foreground="#AFC0FF" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Grid.Row="3" Margin="0,18,0,18">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✓  Mod aktivieren" Style="{StaticResource PillButton}" Margin="0,0,10,0" Click="Activate_Click"/>
                                <Button Content="ⓘ  Informationen" Style="{StaticResource PillButton}" Margin="0,0,10,0" Click="Info_Click"/>
                                <Button Content="🌐  Website öffnen" Style="{StaticResource PillButton}" Margin="0,0,10,0" Click="Website_Click"/>
                                <Button x:Name="btn_Uninstall" Content="🗑  Deinstallieren" Style="{StaticResource PillButton}" HorizontalAlignment="Right" Click="Uninstall_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Mods list view -->
                    <Border x:Name="view_Mods" Visibility="Collapsed" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,18">
                        <ListBox x:Name="lst_Mods" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" Margin="6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,7">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,2,0,0">
                                                <Run Text="{Binding Meta}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" Padding="9,3" Background="#14FFFFFF">
                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextDim}" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
