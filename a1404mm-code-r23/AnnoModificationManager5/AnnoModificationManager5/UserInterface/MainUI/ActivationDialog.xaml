<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lng="clr-namespace:AnnoModificationManager5.Language.DictionarySystem"
        xmlns:bot="clr-namespace:PixelLab.Wpf;assembly=PixelLab.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="AnnoModificationManager5.UserInterface.MainUI.ActivationDialog"
        ResizeMode="NoResize"
        Title="{lng:LanguageMarkup Dictionary=ActivationDialog, Key=Title}" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Image VerticalAlignment="Top" Source="/AnnoModificationManager5;component/Images/Header/headerImage_n05.jpg" Height="60" Stretch="Fill" />
        <Grid Height="30" Margin="8,0,8,8" VerticalAlignment="Bottom">
            <Button Background="{DynamicResource Brush_UI_White}" IsEnabled="False" Content="OK" HorizontalAlignment="Right" Margin="0"
                    x:Name="button_OK" Width="100"
                    Click="button_OK_Click" />
            <Button Background="{DynamicResource Brush_UI_White}"
                    Content="{lng:LanguageMarkup Dictionary=UserInterface, Key=Cancel}" IsEnabled="False" HorizontalAlignment="Right" Margin="0,0,104,0"
                    x:Name="button_Cancel" Width="100" Click="button_Cancel_Click" />
        </Grid>
        <TabControl x:Name="tabControl" Margin="8,32,8,42" BorderBrush="{DynamicResource Brush_UI_Border}">
        	<TabItem Header="{lng:LanguageMarkup Dictionary=ActivationDialog, Key=Tab_Information}" x:Name="tabControl_Information">
        		<Grid Background="White">
        			<Image Margin="8,8,0,348.04" Source="/AnnoModificationManager5;component/Images/Logo/Version3_Comet256.ico" Stretch="Fill" HorizontalAlignment="Left" Width="100" Height="100"/>
        			<TextBlock Margin="112,18.04,8,0" Text="Anno 1404 Modification Manager" VerticalAlignment="Top" FontSize="16" x:Name="field_Name" />
        			<TextBlock Margin="112,43.32,8,0" Text="Version 4.0.0.0" VerticalAlignment="Top" x:Name="field_Version" />
        			<StackPanel Margin="25,112,8,0" Height="100" VerticalAlignment="Top">
        				<StackPanel Orientation="Horizontal">
        					<Image Height="16" Source="/AnnoModificationManager5;component/Images/Icons/page_white.png" Stretch="Fill" Width="16"/>
        					<TextBlock Text="20 Dateien im Anno-Verzeichnis" Margin="5,0,0,0" x:Name="field_Files_Anno" />
        				</StackPanel>
        				<StackPanel Orientation="Horizontal" Margin="0,3,0,0">
        					<Image Height="16" Source="/AnnoModificationManager5;component/Images/Icons/page_white.png" Stretch="Fill" Width="16"/>
        					<TextBlock Text="20 Dateien im AppData-Verzeichnis" Margin="5,0,0,0" x:Name="field_Files_AppData" />
        				</StackPanel>
        				<StackPanel Orientation="Horizontal" Margin="0,5,0,0">
        					<Image Height="16" Source="/AnnoModificationManager5;component/Images/Icons/page_white_code.png" Stretch="Fill" Width="16"/>
        					<TextBlock Text="40 Xml-Module" Margin="5,0,0,0" x:Name="field_XmlModules" />
        				</StackPanel>
        				<StackPanel Orientation="Horizontal" Margin="0,3,0,0">
        					<Image Height="16" Source="/AnnoModificationManager5;component/Images/Icons/page_white_text.png" Stretch="Fill" Width="16"/>
        					<TextBlock Text="40 Listen-Module" Margin="5,0,0,0" x:Name="field_ListModules" />
        				</StackPanel>
        				<StackPanel Orientation="Horizontal" Margin="0,5,0,0">
        					<Image Height="16" Source="/AnnoModificationManager5;component/Images/Icons/pencil.png" Stretch="Fill" Width="16"/>
        					<TextBlock Text="100 Benutzerdefinierte Werte" Margin="5,0,0,0" x:Name="field_UValues" />
        				</StackPanel>
        			</StackPanel>
        			<Grid Margin="25,220,8,22" x:Name="conflictContainer">
        				<Separator Margin="0" VerticalAlignment="Top"/>
                        <TextBlock Text="{lng:LanguageMarkup Dictionary=ActivationDialog,Key=Conflict_Message}" Margin="0,6,0,0" VerticalAlignment="Top"/>
        				<ListView x:Name="list_ConflictMods" Margin="8,24.96,0,27.96" Foreground="Black" BorderBrush="{x:Null}" BorderThickness="0">
        					<ListView.View>
        						<GridView>
        							<GridView.ColumnHeaderContainerStyle>
        								<Style>
        									<Setter Property="UIElement.Visibility" Value="Collapsed"/>						
										</Style>						
									</GridView.ColumnHeaderContainerStyle>                                       
                                    <GridViewColumn Width="500" DisplayMemberBinding="{Binding UI_ModificationName}"/>
                                    <GridViewColumn Width="120" DisplayMemberBinding="{Binding UI_ConflictCountString}"/>
                                    <GridViewColumn>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentPresenter Content="{Binding UI_ConflictTypesIconsStack}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
        						</GridView>
        					</ListView.View>
        				</ListView>
        				<Border x:Name="conflictMods_Loading" HorizontalAlignment="Center" Height="25" VerticalAlignment="Center" Width="150" Background="{DynamicResource Brush_UI_MediumGray}" CornerRadius="2">
        					<StackPanel Orientation="Horizontal">
        						<Image Source="/AnnoModificationManager5;component/Images/Icons/hourglass.png" Stretch="Fill" Width="16" Height="16" Margin="5,0,0,0"/>
        						<TextBlock Text="{lng:LanguageMarkup Dictionary=UserInterface, Key=WaitMessage}" VerticalAlignment="Center" Margin="5,0,0,0"/>
        					</StackPanel>
        				</Border>
        				<CheckBox x:Name="conflict_DeactivateIncompatible" Content="{lng:LanguageMarkup Dictionary=ActivationDialog, Key=Conflict_DeactivateIncompatible}" HorizontalAlignment="Left" Margin="8,0,0,8" VerticalAlignment="Bottom" IsChecked="True"/>
        			</Grid>
        			<ProgressBar Height="10" Margin="25,0,8,8" VerticalAlignment="Bottom" Background="White" Foreground="{DynamicResource Brush_UI_Blue}" BorderBrush="{DynamicResource Brush_UI_Border}" Visibility="Hidden"
                            x:Name="progress_Activation" />
        			<CheckBox x:Name="features_CreateRestorePoint" Content="{lng:LanguageMarkup Dictionary=ActivationDialog, Key=Feature_CreateRestorePoint}" HorizontalAlignment="Left" Margin="32.58,0,0,8" VerticalAlignment="Bottom" Visibility="Hidden" />
        		</Grid>
        	</TabItem>
        	<TabItem Header="{lng:LanguageMarkup Dictionary=ActivationDialog, Key=Tab_UserdefinedValues}" x:Name="tabItem_UValues">
        		<ListView ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="Black" BorderBrush="{x:Null}" BorderThickness="0" x:Name="list_UserdefinedValues">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander  IsExpanded="True"  Style="{DynamicResource ExpanderStyle_Small}">
                                                    <Expander.Header>
                                                        <TextBlock FontWeight="Bold" Text="{Binding Name}"/>
                                                    </Expander.Header>
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
        				<GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style>
                                    <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="{Binding ActualWidth, ElementName=list_UserdefinedValues}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>                                            
                                            <Grid VerticalAlignment="Top" Height="21.96">
                                                <Image HorizontalAlignment="Left" Margin="0,3,0,0" Source="{Binding UI_Icon}" Stretch="Fill" Width="16" VerticalAlignment="Top" Height="16"/>
                                                <TextBlock HorizontalAlignment="Left" Margin="20,3,0,0" Text="{Binding UI_Name}" VerticalAlignment="Top" Width="Auto"/>
                                                <ContentPresenter Width="230" Margin="0,0,20,0"  HorizontalAlignment="Right" Content="{Binding UI_Editor}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding UI_Description}" Margin="21,22,0,0" VerticalAlignment="Top" Foreground="Gray"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
        			</ListView.View>           			
        		</ListView>
        	</TabItem>
        </TabControl>
    </Grid>
</Window>
