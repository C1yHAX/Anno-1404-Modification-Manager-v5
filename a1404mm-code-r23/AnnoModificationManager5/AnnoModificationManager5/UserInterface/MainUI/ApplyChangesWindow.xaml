<Window  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lng="clr-namespace:AnnoModificationManager5.Language.DictionarySystem"
        xmlns:bot="clr-namespace:PixelLab.Wpf;assembly=PixelLab.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="AnnoModificationManager5.UserInterface.MainUI.ApplyChangesWindow"
        ResizeMode="NoResize"
        Title="{lng:LanguageMarkup Dictionary=ApplyChangesDialog, Key=Title}" Height="600" Width="800" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid Height="30" Margin="8,0,8,8" VerticalAlignment="Bottom">
            <Button Background="{DynamicResource Brush_UI_White}" Content="OK" HorizontalAlignment="Right" Margin="0"
                    x:Name="button_OK" Width="100"
                    Click="button_OK_Click" />
            <Button Background="{DynamicResource Brush_UI_White}"
                    Content="{lng:LanguageMarkup Dictionary=UserInterface, Key=Cancel}"
                    HorizontalAlignment="Right" Margin="0,0,104,0"
                    x:Name="button_Cancel" Width="100" Click="button_Cancel_Click" />
        </Grid>
        <Image Height="146" HorizontalAlignment="Left" Stretch="Uniform" VerticalAlignment="Top" Width="155"
                Source="/AnnoModificationManager5;component/Images/Icon.png" />
        <ProgressBar Height="10" Margin="12,0,12,69" Name="prg_AllOperations" VerticalAlignment="Bottom" Background="{DynamicResource Brush_UI_White}" Foreground="{DynamicResource Brush_UI_Blue}" BorderBrush="{DynamicResource Brush_UI_Border}"/>
        <ProgressBar Height="10" Margin="12,0,12,84" Name="prg_CurrentOperation" VerticalAlignment="Bottom" Background="{DynamicResource Brush_UI_White}" Foreground="{DynamicResource Brush_UI_Blue}" BorderBrush="{DynamicResource Brush_UI_Border}"/>
        <Label Content="{lng:LanguageMarkup Dictionary=ApplyChangesDialog,Key=Message}" Height="56" HorizontalAlignment="Left" Margin="161,12,0,0"  VerticalAlignment="Top" Width="605" />
        <Label Content="Ready." Height="28" HorizontalAlignment="Left" Margin="161,433,0,0" Name="lbl_Status" VerticalAlignment="Top" Width="605" />
        <Grid Margin="193,74,41,134">
            <ListView  Name="lv_RDAFilesPending" BorderBrush="{x:Null}" BorderThickness="0" Foreground="#FFE3ECF6">
              
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn Width="32">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Width="16" Height="16" Source="/AnnoModificationManager5;component/Images/page_white_zip.png" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="300"/>
                    </GridView>
                </ListView.View>
            </ListView>
                <Border x:Name="brd_WaitMessage" HorizontalAlignment="Center" Height="25" VerticalAlignment="Center" Width="150" Background="{DynamicResource Brush_UI_MediumGray}" CornerRadius="2" Visibility="Hidden">
            <StackPanel Orientation="Horizontal">
                <Image Source="/AnnoModificationManager5;component/Images/Icons/hourglass.png" Stretch="Fill" Width="16" Height="16" Margin="5,0,0,0"/>
                <TextBlock Text="{lng:LanguageMarkup Dictionary=UserInterface, Key=WaitMessage}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
