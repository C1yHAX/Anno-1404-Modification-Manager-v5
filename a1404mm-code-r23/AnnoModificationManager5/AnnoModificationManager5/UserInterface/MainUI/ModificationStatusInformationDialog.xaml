<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lng="clr-namespace:AnnoModificationManager5.Language.DictionarySystem"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="AnnoModificationManager5.UserInterface.MainUI.ModificationStatusInformationDialog" Style="{StaticResource DarkWindowChrome}" Height="600" Width="800" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource Brush_UI_White}">
                <TextBlock Margin="112,18.04,8,0" Text="Anno 1404 Modification Manager" VerticalAlignment="Top" FontSize="16" x:Name="field_Name" />
        <TextBlock Margin="112,43.32,8,0" Text="Version 4.0.0.0" VerticalAlignment="Top" x:Name="field_Version" />
        <StackPanel Margin="25,112,8,0" Height="100" VerticalAlignment="Top">
            <DockPanel LastChildFill="False" >
                <Image Height="16" Source="/AnnoModificationManager5;component/Images/Icons/page_white.png" Stretch="Fill" Width="16"/>
                <TextBlock Text="20 Dateien im Anno-Verzeichnis" Margin="5,0,0,0" x:Name="field_Files_Anno" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                	<ProgressBar Height="10" Width="100" VerticalAlignment="Center" Background="{DynamicResource Brush_UI_White}" BorderBrush="{DynamicResource Brush_UI_Border}" Foreground="{DynamicResource Brush_UI_Blue}" Name="field_Files_Anno_Progress" />
                	<TextBlock Text="20/20" Margin="3,0,0,0" Name="field_Files_Anno_Status" />
                </StackPanel>
            </DockPanel>
            <DockPanel  Margin="0,3,0,0" LastChildFill="False">
                <Image Height="16" Source="/AnnoModificationManager5;component/Images/Icons/page_white.png" Stretch="Fill" Width="16"/>
                <TextBlock Text="20 Dateien im AppData-Verzeichnis" Margin="5,0,0,0" x:Name="field_Files_AppData" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                	<ProgressBar Height="10" Width="100" VerticalAlignment="Center" Background="{DynamicResource Brush_UI_White}" BorderBrush="{DynamicResource Brush_UI_Border}" Foreground="{DynamicResource Brush_UI_Blue}" Name="field_Files_AppData_Progress" />
                	<TextBlock Text="20/20" Margin="3,0,0,0" Name="field_Files_AppData_Status" />
                </StackPanel>
            </DockPanel>
            <DockPanel  Margin="0,5,0,0" LastChildFill="False">
                <Image Height="16" Source="/AnnoModificationManager5;component/Images/Icons/page_white_code.png" Stretch="Fill" Width="16"/>
                <TextBlock Text="40 Xml-Module" Margin="5,0,0,0" x:Name="field_XmlModules" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                	<ProgressBar Height="10" Width="100" VerticalAlignment="Center" Background="{DynamicResource Brush_UI_White}" BorderBrush="{DynamicResource Brush_UI_Border}" Foreground="{DynamicResource Brush_UI_Blue}" Name="field_XmlModules_Progress" />
                	<TextBlock Text="20/20" Margin="3,0,0,0" Name="field_XmlModules_Status" />
                </StackPanel>
            </DockPanel>
            <DockPanel  Margin="0,3,0,0" LastChildFill="False">
                <Image Height="16" Source="/AnnoModificationManager5;component/Images/Icons/page_white_text.png" Stretch="Fill" Width="16"/>
                <TextBlock Text="40 Listen-Module" Margin="5,0,0,0" x:Name="field_ListModules" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                	<ProgressBar Height="10" Width="100" VerticalAlignment="Center" Background="{DynamicResource Brush_UI_White}" BorderBrush="{DynamicResource Brush_UI_Border}" Foreground="{DynamicResource Brush_UI_Blue}" Name="field_ListModules_Progress" />
                	<TextBlock Text="20/20" Margin="3,0,0,0" Name="field_ListModules_Status" />
                </StackPanel>
            </DockPanel>
            <DockPanel  Margin="0,5,0,0" LastChildFill="False">
                <Image Height="16" Source="/AnnoModificationManager5;component/Images/Icons/pencil.png" Stretch="Fill" Width="16"/>
                <TextBlock Text="100 Benutzerdefinierte Werte" Margin="5,0,0,0" x:Name="field_UValues" />                
            </DockPanel>
        </StackPanel>
        <TextBox x:Name="field_ActivationLog" Margin="25,221,8,8" Text="TextBox" Background="#8C12223A" BorderBrush="{x:Null}" BorderThickness="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
        <Separator Margin="25,216,8,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
