<Window x:Class="AnnoModificationManager5.UserInterface.Misc.FolderBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lng="clr-namespace:AnnoModificationManager5.Language.DictionarySystem"
        Title="" Height="480" Width="640" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid Height="30" Margin="8,0,8,8" VerticalAlignment="Bottom">
            <Button Background="{DynamicResource Brush_UI_White}" IsEnabled="True" Content="OK" HorizontalAlignment="Right" Margin="0"
                    x:Name="button_OK" Width="100"
                    Click="button_OK_Click" />
            <Button Background="{DynamicResource Brush_UI_White}"
                    Content="{lng:LanguageMarkup Dictionary=UserInterface, Key=Cancel}" IsEnabled="True" HorizontalAlignment="Right" Margin="0,0,104,0"
                    x:Name="button_Cancel" Width="100" Click="button_Cancel_Click" />
        </Grid>
        <TreeView x:Name="folderList" Margin="0,0,0,44" BorderThickness="0" SelectedItemChanged="folderList_SelectedItemChanged" />
    </Grid>
</Window>
