<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lng="clr-namespace:AnnoModificationManager5.Language.DictionarySystem"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="AnnoModificationManager5.UserInterface.Startup.StartupDialog" Style="{StaticResource DarkWindowChrome}"
        Loaded="Window_Loaded" Title="Anno 1404 Modification Manager 5" Height="640" Width="680" Icon="/AnnoModificationManager5;component/Images/Logo/Version3_Comet20.ico" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#FF0F172A">
        <Grid Height="30" Margin="8,0,8,8" VerticalAlignment="Bottom">
            <Button x:Name="button_OK" Content="OK" HorizontalAlignment="Right" Margin="0" Width="100" d:LayoutOverrides="Height" Background="{DynamicResource Brush_UI_White}" Click="button_OK_Click" />
            <Button x:Name="button_Cancel" Content="{lng:LanguageMarkup Dictionary=UserInterface,Key=Cancel}" HorizontalAlignment="Right" Margin="0,0,104,0" Width="100" d:LayoutOverrides="Height" Background="{DynamicResource Brush_UI_White}"
                    Click="button_Cancel_Click" />
            <Button x:Name="button_Help" Content="{lng:LanguageMarkup Dictionary=UserInterface,Key=Help}" HorizontalAlignment="Left" Margin="0,0,104,0" Width="100" d:LayoutOverrides="Height" Background="{DynamicResource Brush_UI_White}"
                    Click="button_Help_Click" />
        </Grid>
        <ScrollViewer Margin="8,48,8,42" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <GroupBox Header="Sprache / Language">
                <StackPanel>
                    <RadioButton x:Name="radio_Language_German" Content="Deutsch" Margin="0,3,0,0" Checked="radio_UpdateLanguage" />
                    <RadioButton x:Name="radio_Language_English" Content="English" Margin="0,3,0,0" Checked="radio_UpdateLanguage" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="{lng:LanguageMarkup Dictionary=UserInterface, Key=Startup_GroupBox_AnnoDirectory}">
                <Grid>
                    <TextBox Text="" Height="21.96" VerticalAlignment="Top" BorderBrush="{x:Null}" x:Name="field_AnnoDirectory" />
                    <RadioButton Unchecked="radio_AnnoDirectory_Auto_Checked" Checked="radio_AnnoDirectory_Auto_Checked" Content="{lng:LanguageMarkup Dictionary=UserInterface, Key=Startup_GroupBox_AnnoDirectory_Auto}" HorizontalAlignment="Left" Margin="8,25.96,0,0" VerticalAlignment="Top" x:Name="radio_AnnoDirectory_Auto" />
                    <RadioButton Unchecked="radio_AnnoDirectory_Choose_Checked" Checked="radio_AnnoDirectory_Choose_Checked" Content="{lng:LanguageMarkup Dictionary=UserInterface, Key=Startup_GroupBox_AnnoDirectory_Choose}" HorizontalAlignment="Left" Margin="8,45.92,0,0" VerticalAlignment="Top" x:Name="radio_AnnoDirectory_Choose" />
                </Grid>
            </GroupBox>
            <GroupBox Header="Anno 1404 Version">
                <StackPanel>
                    <RadioButton x:Name="radio_Version_Retail" Content="Retail" IsChecked="True" Margin="0,3,0,0"/>
                    <RadioButton x:Name="radio_Version_Patch1" Content="Patch 1" Margin="0,3,0,0"/>
                    <RadioButton x:Name="radio_Version_Patch2" Content="Patch 2" Margin="0,3,0,0"/>
                    <RadioButton x:Name="radio_Version_Patch3" Content="Patch 3" Margin="0,3,0,0"/>
                    <RadioButton x:Name="radio_Version_Mod_IAAM" Content="IAAM Mod" Margin="0,3,0,0"/>
                    <Separator Margin="0,5" HorizontalAlignment="Left" Width="100"/>
                    <RadioButton x:Name="radio_Version_Addon1" Content="Addon 1"/>
                    <RadioButton x:Name="radio_Version_Addon1_Patch1" Content="Addon 1, Patch 1"/>
                    <Separator Margin="0,5" HorizontalAlignment="Left" Width="100"/>
                    <!-- Neue Optionen für die History Edition -->
                    <RadioButton x:Name="radio_Version_HistoryEdition" Content="History Edition" Margin="0,3,0,0"/>
                    <RadioButton x:Name="radio_Version_HistoryEdition_Addon" Content="History Edition Addon" Margin="0,3,0,0"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
