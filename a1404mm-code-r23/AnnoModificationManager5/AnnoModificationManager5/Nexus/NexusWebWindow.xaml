<Window x:Class="AnnoModificationManager5.Nexus.NexusWebWindow" Style="{StaticResource DarkWindowChrome}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Nexus Mods – Browser" Height="780" Width="1120" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="6" LastChildFill="True">
            <Button x:Name="btn_Back" Content="◀" Width="34" Margin="0,0,4,0" Click="btn_Back_Click"/>
            <Button x:Name="btn_Forward" Content="▶" Width="34" Margin="0,0,4,0" Click="btn_Forward_Click"/>
            <Button x:Name="btn_Home" Content="Anno-1404-Mods" Width="130" Margin="0,0,6,0" Click="btn_Home_Click"/>
            <Button x:Name="btn_Close" DockPanel.Dock="Right" Content="Schließen" Width="90" Margin="6,0,0,0" Click="btn_Close_Click"/>
            <TextBlock x:Name="lbl_Status" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,8,0" Foreground="Gray"/>
            <TextBox x:Name="txt_Url" VerticalContentAlignment="Center" KeyDown="txt_Url_KeyDown"/>
        </DockPanel>
        <wv2:WebView2 x:Name="web"/>
    </DockPanel>
</Window>
