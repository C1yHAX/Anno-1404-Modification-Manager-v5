<Window x:Class="AnnoModificationManager5.Nexus.NexusLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Mods – Anmelden" Height="300" Width="480"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap"
                   Text="Zum Laden von Mods über Nexus Mods wird dein persönlicher API-Key benötigt. Öffne die API-Seite, kopiere den 'Personal API Key' und füge ihn hier ein."/>

        <Button Grid.Row="1" x:Name="btn_OpenApiPage" Content="API-Key-Seite öffnen"
                Margin="0,10,0,0" HorizontalAlignment="Left" Width="180" Click="btn_OpenApiPage_Click"/>

        <TextBlock Grid.Row="2" Text="API-Key:" Margin="0,12,0,2"/>
        <TextBox Grid.Row="3" x:Name="txt_Key" Height="52" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <Button Grid.Row="4" x:Name="btn_Login" Content="Anmelden"
                Margin="0,10,0,0" HorizontalAlignment="Left" Width="120" Click="btn_Login_Click"/>

        <TextBlock Grid.Row="5" x:Name="lbl_Status" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="Gray"/>

        <Button Grid.Row="6" x:Name="btn_Close" Content="Schließen"
                HorizontalAlignment="Right" Width="100" Click="btn_Close_Click"/>
    </Grid>
</Window>
