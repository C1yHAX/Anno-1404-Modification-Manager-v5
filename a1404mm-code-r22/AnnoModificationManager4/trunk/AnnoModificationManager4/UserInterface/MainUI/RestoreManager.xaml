<Window x:Class="AnnoModificationManager4.UserInterface.MainUI.RestoreManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lng="clr-namespace:AnnoModificationManager4.Language.DictionarySystem"
        Title="{lng:LanguageMarkup Dictionary=RestoreManager,Key=Title}" ResizeMode="NoResize" Height="600" Width="800" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
    	<ToolBar Height="27" VerticalAlignment="Bottom" Background="{DynamicResource Brush_UI_White}" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0,1,0,0" IsOverflowOpen="False">
    		<Button Click="button_Restore_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="button_Restore">
    			<StackPanel Orientation="Horizontal">
    				<Image Height="16" Source="/AnnoModificationManager4;component/Images/Logo/Version3_Comet20.ico" Stretch="Fill" Width="16"/>
    				<TextBlock Text="{lng:LanguageMarkup Dictionary=RestoreManager,Key=Button_Restore}" Margin="5,0,0,0"/>
    			</StackPanel>
    		</Button>
    			<Border BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0,0,1,0" Margin="5,0"/>
    		<Button Click="button_Add_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="button_Add">
    			<Image Height="16" Source="/AnnoModificationManager4;component/Images/Icons/add.png" Width="16" Stretch="Fill"/>
    		</Button>
    		<Button Click="button_Remove_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="button_Remove">
    			<Image Height="16" Source="/AnnoModificationManager4;component/Images/Icons/delete.png" Width="16" Stretch="Fill"/>
    		</Button>
    	</ToolBar>
    	<ListView ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,27" Foreground="Black" BorderBrush="{x:Null}" BorderThickness="0" Name="list_Restore">
    		<ListView.View>
    			<GridView>
                    <GridView.ColumnHeaderContainerStyle>
                        <Style>
                            <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridViewColumn Width="28">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding GetIcon}" Width="16" Height="16" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="445" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Width="220" DisplayMemberBinding="{Binding DateString}"/>
                    <GridViewColumn Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AnnoVersion}" Foreground="Gray"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
    		</ListView.View>
    	</ListView>
        
    </Grid>
</Window>
