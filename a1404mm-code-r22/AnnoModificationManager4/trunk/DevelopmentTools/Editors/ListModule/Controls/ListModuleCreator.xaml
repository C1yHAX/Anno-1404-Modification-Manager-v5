<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="DevelopmentTools.Editors.ListModule.Controls.ListModuleCreator"
        Title="ListModule Creator/Editor" Height="480" Width="640" WindowStartupLocation="CenterScreen">
    <Grid>
        <DockPanel Height="30" LastChildFill="False" Margin="10,0,8,8" VerticalAlignment="Bottom">
            <Button Background="{DynamicResource Brush_UI_White}" Click="button_ok_Click" Content="OK" DockPanel.Dock="Right" Margin="0,0,5,0"
                    x:Name="button_ok" Width="100" />
            <Button Background="{DynamicResource Brush_UI_White}" Click="button_cancel_Click" Content="Cancel" DockPanel.Dock="Right"
                    Margin="0,0,5,0" x:Name="button_cancel" Width="100" />
        </DockPanel>
        <Image Height="60" Margin="0" Source="/DevelopmentTools;component/Images/Header/headerImage_n05.jpg" Stretch="Fill" VerticalAlignment="Top"/>
        <StackPanel Margin="8,60,8,42">
            <Grid x:Name="g_File" >
                <Grid HorizontalAlignment="Left" Width="100">
                    <TextBlock TextWrapping="NoWrap" Text="File" VerticalAlignment="Center" d:LayoutOverrides="Width" HorizontalAlignment="Left"/>
                </Grid>
                <ComboBox x:Name="Files_File" Margin="100,0,25,0" d:LayoutOverrides="Height" DropDownOpened="Files_File_DropDownOpened"  IsEditable="True"/>
                <Button Width="22" Content="..." Name="Files_Files_Open" Click="Files_Files_Open_Click" HorizontalAlignment="Right"/>
            </Grid>
            <Grid x:Name="g_OldValue" Visibility="Collapsed">
                <Grid HorizontalAlignment="Left" Width="100">
                    <TextBlock TextWrapping="NoWrap" Text="Old Value" VerticalAlignment="Center" d:LayoutOverrides="Width" HorizontalAlignment="Left"/>
                </Grid>
                <TextBox x:Name="Field_OldValue" TextWrapping="NoWrap" d:LayoutOverrides="Height" Margin="100,0,0,0"/>
            </Grid>
            <Grid x:Name="g_NewValue">
        		<Grid HorizontalAlignment="Left" Width="100">
        			<TextBlock TextWrapping="NoWrap" Text="New Value" VerticalAlignment="Center" d:LayoutOverrides="Width" HorizontalAlignment="Left"/>
        		</Grid>
        		<TextBox x:Name="Field_NewValue" TextWrapping="NoWrap" d:LayoutOverrides="Height" Margin="100,0,0,0"/>
        	</Grid>
            <Grid x:Name="g_Group">
                <Grid HorizontalAlignment="Left" Width="100">
                    <TextBlock TextWrapping="NoWrap" Text="Group" VerticalAlignment="Center" d:LayoutOverrides="Width" HorizontalAlignment="Left"/>
                </Grid>
                <TextBox x:Name="Field_Group" TextWrapping="NoWrap" d:LayoutOverrides="Height" Margin="100,0,0,0"/>
            </Grid>
            <Grid Background="White" Height="225" Margin="0,10,0,0">
        		<ListView Margin="0,0,0,27" Foreground="Black" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0"
        			x:Name="UserdefinedValues_List">
        			<ListView.View>
        				<GridView>
        					<GridViewColumn Header="Key" Width="150" >
        						<GridViewColumn.CellTemplate>
        							<DataTemplate>
        								<TextBox Text="{Binding Key}"/>
        							</DataTemplate>
        						</GridViewColumn.CellTemplate>
        					</GridViewColumn>
        					<GridViewColumn Header="Written Value" Width="150" >
        						<GridViewColumn.CellTemplate>
        							<DataTemplate>
        								<TextBox Text="{Binding Math}"/>
        							</DataTemplate>
        						</GridViewColumn.CellTemplate>
        					</GridViewColumn>
        					<GridViewColumn Header="Userdefined Value" Width="150">
        						<GridViewColumn.CellTemplate>
        							<DataTemplate>
        								<ComboBox DropDownOpened="UserdefinedValue_ComboBox_DropDownOpened"  IsEditable="True" Text="{Binding UserdefinedValueName}"/>
        							</DataTemplate>
        						</GridViewColumn.CellTemplate>
        					</GridViewColumn>
        				</GridView>
        			</ListView.View>
        		</ListView>
        		<ToolBar Height="27" VerticalAlignment="Bottom" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0" IsOverflowOpen="False">
        			<Button Click="UserdefinedValues_List_Add_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" x:Name="UserdefinedValues_List_Add">
        				<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/add.png" Stretch="Fill" Width="16"/>
        			</Button>
        			<Button Click="UserdefinedValues_List_Remove_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" x:Name="UserdefinedValues_List_Remove">
        				<Image Height="16" Source="/DevelopmentTools;component/Images/Icons/delete.png" Stretch="Fill" Width="16"/>
        			</Button>
        		</ToolBar>
        		<Border BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="1" x:Name="brd_UserDefValues"/>
        	</Grid>
        </StackPanel>
    </Grid>
</Window>
