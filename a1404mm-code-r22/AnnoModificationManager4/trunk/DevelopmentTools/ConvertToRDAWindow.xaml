<Window x:Class="DevelopmentTools.ConvertToRDAWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert AMM4 to AMM4.2 modification" Height="480" Width="640" WindowStartupLocation="CenterScreen">
    <Grid>
        <TextBlock Text="You have to convert the modification to the new AMM4.2 format, supporting RDA packages." VerticalAlignment="Top"/>
        <TextBox Margin="12,22,12,65" Name="txb_Output" Text="Ready." IsReadOnly="True"/>
        <Button Content="Convert" Height="23" HorizontalAlignment="Left" Margin="531,406,0,0" Name="b_OK" VerticalAlignment="Top" Width="75"
                Click="b_OK_Click" />
        <Button Content="Cancel" IsCancel="True" Height="23" HorizontalAlignment="Left" Margin="450,406,0,0" Name="b_Cancel" VerticalAlignment="Top" Width="75" />
        <CheckBox Content="Prefer Addon RDAs (if available)" IsChecked="True" Height="16" HorizontalAlignment="Left" Margin="12,382,0,0" Name="chk_SupportAddon" VerticalAlignment="Top" />
    </Grid>
</Window>
