<Window x:Class="DevelopmentTools.Tools.Global.RDAFileBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:RDAExplorerGUI.Controls;assembly=RDAExplorerGUI"
        Title="RDA File Browser" Height="480" Width="640" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <TreeView Grid.Column="0" BorderThickness="0,0,1,0" Name="rdaFiles" SelectedItemChanged="rdaFiles_SelectedItemChanged">

        </TreeView>
        <ctrl:RDATreeView x:Name="rdaView" Grid.Column="1" BorderThickness="0" PreviewMouseDown="rdaView_PreviewMouseDown"/>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0">
            <Button Content="Cancel" Name="b_Cancel" Width="100" Height="25" Margin="0,0,5,0" IsCancel="True"/>
                         <Button Content="OK" Name="b_OK" Width="100" Height="25"  Click="b_OK_Click"/>
        </StackPanel>              
    </Grid>
</Window>
