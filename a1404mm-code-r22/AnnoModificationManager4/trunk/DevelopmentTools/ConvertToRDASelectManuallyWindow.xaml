<Window x:Class="DevelopmentTools.ConvertToRDASelectManuallyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="Select RDA" Height="250" Width="400" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <TextBlock Name="txb_Message" VerticalAlignment="Top"  Text="Text"/>
        <ComboBox Height="23" Margin="12,67,12,0" Name="cmb_RDAs" VerticalAlignment="Top" IsEditable="False" SelectedIndex="0" >
            <ComboBox.Items>
                <system:String >maindata</system:String>
                <system:String>addon</system:String>
            </ComboBox.Items>
        </ComboBox>
        <Button Content="OK" Height="23" HorizontalAlignment="Left" Margin="291,176,0,0" Name="b_OK" VerticalAlignment="Top" Width="75"
                Click="b_OK_Click" />
        <Button Content="Cancel" Height="23" HorizontalAlignment="Left" Margin="210,176,0,0" Name="b_Cancel" IsCancel="True" VerticalAlignment="Top" Width="75" />
        <CheckBox Content="Auto assign: data/... -> maindata, addondata/... -> addon" Height="16" HorizontalAlignment="Left" Margin="12,148,0,0" Name="chb_EnableAutoAssign" VerticalAlignment="Top" />
    </Grid>
</Window>
