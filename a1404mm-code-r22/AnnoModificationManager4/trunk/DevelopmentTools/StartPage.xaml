<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:devctrls="clr-namespace:DevelopmentTools.Controls"
             xmlns:DevelopmentTools_Tools_StartPage="clr-namespace:DevelopmentTools.Tools.StartPage" x:Class="DevelopmentTools.StartPage"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="640" Loaded="StartPage_Loaded">
    <Grid Background="White">
    	<Image Source="Images/Header/headerImage_n05.jpg"/>
    	<Border BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="1" HorizontalAlignment="Center" Height="300" VerticalAlignment="Center" Width="400" Background="White" CornerRadius="2">
    		<Grid>
    			<Image Margin="8,8,290,0" Source="Images/Logo/Version3_Comet256.ico" Stretch="Fill" Width="100" Height="100" VerticalAlignment="Top"/>
    			<TextBlock Margin="112,18,8,0" TextWrapping="NoWrap" Text="Development Tools" VerticalAlignment="Top" FontSize="16"/>
    			<TextBlock Margin="112,39.28,8,0" TextWrapping="NoWrap" Text="Version 4" VerticalAlignment="Top" FontSize="16" Foreground="{DynamicResource Brush_UI_Border}"/>
    			<Button Click="Project_NewProject_Click" Margin="8,112,8,0" VerticalAlignment="Top" Height="25" Background="{x:Null}" BorderBrush="{x:Null}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" x:Name="Project_NewProject">
    				<StackPanel Orientation="Horizontal">
    					<Image Source="Images/Icons/page_white.png" Stretch="Fill" Width="16" Height="16" Margin="3,0,0,0"/>
    					<TextBlock TextWrapping="NoWrap" Text="New Project" VerticalAlignment="Center" Margin="5,0,0,0"/>
    				</StackPanel>
    			</Button>
    			<Button Click="Project_OpenProject_Click" Margin="8,137,8,136" Background="{x:Null}" BorderBrush="{x:Null}" Height="25" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" x:Name="Project_OpenProject">
    				<StackPanel Orientation="Horizontal">
    					<Image Source="Images/Icons/folder.png" Stretch="Fill" Width="16" Height="16" Margin="3,0,0,0"/>
    					<TextBlock TextWrapping="NoWrap" Text="Open Project" VerticalAlignment="Center" Margin="5,0,0,0"/>
    				</StackPanel>
    			</Button>
                <devctrls:DropDownButton Margin="8,0,8,111" Background="{x:Null}" BorderBrush="{x:Null}" Height="25" VerticalAlignment="Bottom" d:LayoutOverrides="Height" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        x:Name="Project_RecentProjects">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Images/Icons/folder_star.png" Stretch="Fill" Width="16" Height="16" Margin="3,0,0,0"/>
                        <TextBlock TextWrapping="NoWrap" Text="Recent Projects" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </devctrls:DropDownButton>
                <Button Click="Project_ConvertProject_Click" Margin="8,0,8,72" Background="{x:Null}" BorderBrush="{x:Null}" Height="25" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" VerticalAlignment="Bottom" d:LayoutOverrides="Height" x:Name="Project_ConvertProject">
                	<StackPanel Orientation="Horizontal">
                		<Image Source="Images/Icons/arrow_refresh.png" Stretch="Fill" Width="16" Height="16" Margin="3,0,0,0"/>
                		<TextBlock TextWrapping="NoWrap" Text="Convert Modification Package" VerticalAlignment="Center" Margin="5,0,0,0"/>
                	</StackPanel>
                </Button>
                <Button Click="Project_StartPublisher_Click" Margin="8,0,8,47" Background="{x:Null}" BorderBrush="{x:Null}" Height="25" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" VerticalAlignment="Bottom" d:LayoutOverrides="Height" x:Name="Project_StartPublisher">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/DevelopmentTools;component/Images/Icons/world.png" Stretch="Fill" Width="16" Height="16" Margin="3,0,0,0"/>
                        <TextBlock TextWrapping="NoWrap" Text="Modification Package Publisher" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>
                <Separator Height="10" Margin="8,0,0,97" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="100"/>
                <Button Click="ShowHelp_Click"  Background="{x:Null}" BorderBrush="{x:Null}" Height="25" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" VerticalAlignment="Bottom" x:Name="ShowHelp" d:LayoutOverrides="Height" HorizontalAlignment="Left" Width="60" Margin="2,0,0,2">
                	<StackPanel Orientation="Horizontal">
                		<Image Source="Images/Icons/help.png" Stretch="Fill" Width="16" Height="16" Margin="3,0,0,0"/>
                		<TextBlock TextWrapping="NoWrap" Text="Help" VerticalAlignment="Center" Margin="5,0,0,0"/>
                	</StackPanel>
                </Button>
                <Button Click="ShowSettings_Click"  Background="{x:Null}" BorderBrush="{x:Null}" Height="25" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" VerticalAlignment="Bottom" x:Name="ShowSettings" Margin="66,0,257,2" d:LayoutOverrides="Height" Width="75">
                	<StackPanel Orientation="Horizontal">
                		<Image Source="Images/Icons/cog.png" Stretch="Fill" Width="16" Height="16" Margin="3,0,0,0"/>
                		<TextBlock TextWrapping="NoWrap" Text="Settings" VerticalAlignment="Center" Margin="5,0,0,0"/>
                	</StackPanel>
                </Button>
    			<DevelopmentTools_Tools_StartPage:UpdateButton HorizontalAlignment="Right" Margin="0,0,2,2" VerticalAlignment="Bottom" Height="25"/>
            </Grid>
    	</Border>
    </Grid>
</UserControl>
