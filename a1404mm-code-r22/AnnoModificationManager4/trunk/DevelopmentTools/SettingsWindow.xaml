<Window x:Class="DevelopmentTools.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="480" Width="640"
        Icon="/DevelopmentTools;component/Images/Icons/cog.png" WindowStartupLocation="CenterScreen">
    <Grid>
    	<Image Margin="0" Source="Images/Header/headerImage_n05.jpg" Stretch="Fill" Height="90" VerticalAlignment="Top"/>
    	<TabControl Margin="8,29,8,8" Background="White" BorderBrush="{DynamicResource Brush_UI_Border}">
    		<TabItem Header="General">
                <Grid Background="White">    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <TextBlock Margin="5,0,0,0" Text="RDA Working Directory" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Height="22" VerticalAlignment="Center" IsReadOnly="True" Name="txb_RDAWorkingDir"/>
                        <Button Content="..." Grid.Column="1" Width="22" Height="22" Name="b_SetRDAWorkingDir" Click="b_SetRDAWorkingDir_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
    		<TabItem Header="Recent Files">
    			<Grid Background="White">
    				<ListView x:Name="RecentFiles_Files" Margin="0,0,0,26" BorderThickness="0" Foreground="Black" BorderBrush="{x:Null}">
    					<ListView.View>
    						<GridView>           
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style>
                                        <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
    							<GridViewColumn Width="25">
    								<GridViewColumn.CellTemplate>
    									<DataTemplate>
    										<Image Source="/DevelopmentTools;component/Images/Icons/page_white.png" Stretch="UniformToFill" />			
										</DataTemplate>			
									</GridViewColumn.CellTemplate>			
								</GridViewColumn>
                                <GridViewColumn Width="Auto"/>
    						</GridView>
    					</ListView.View>
    				</ListView>
    				<ToolBar Height="26" VerticalAlignment="Bottom" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0,1,0,0" IsOverflowOpen="False">
    					<Button Click="RecentFiles_Files_Add_Click" x:Name="RecentFiles_Files_Add" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    						<Image Height="16" Source="Images/Icons/add.png" Stretch="Fill" Width="16"/>
    					</Button>
    					<Button Click="RecentFiles_Files_Remove_Click" x:Name="RecentFiles_Files_Remove" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    						<Image Height="16" Source="Images/Icons/delete.png" Stretch="Fill" Width="16"/>
    					</Button>
    				</ToolBar>
    			</Grid>
    		</TabItem>
    	</TabControl>
        
    </Grid>
</Window>
