<ammctrls:ModifiedTreeViewItem x:Class="RDAExplorerGUI.Misc.RDAFolderTreeViewItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ammctrls="clr-namespace:RDAExplorerGUI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"> 
    <ammctrls:ModifiedTreeViewItem.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Extract" Name="context_Extract" Click="context_Extract_Click">
                <MenuItem.Icon>
                    <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/page_white_copy.png" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Add files ..." Name="context_AddFiles" Click="context_AddFiles_Click">
                <MenuItem.Icon>
                    <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/add.png" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Add folder ..." Name="context_AddFolder" Click="context_AddFolder_Click">
                <MenuItem.Icon>
                    <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/add.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Add folder as root ..." Name="context_AddFolderAsRoot" Click="context_AddFolderAsRoot_Click">
                <MenuItem.Icon>
                    <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/add.png" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="New folder" Name="context_NewFolder" Click="context_NewFolder_Click">
                <MenuItem.Icon>
                    <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/folder_add.png" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Delete" Name="context_Delete" Click="context_Delete_Click">
                <MenuItem.Icon>
                    <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/delete.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </ammctrls:ModifiedTreeViewItem.ContextMenu>
</ammctrls:ModifiedTreeViewItem>
    
