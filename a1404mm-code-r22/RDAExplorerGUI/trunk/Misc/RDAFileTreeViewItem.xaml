<ammctrls:ModifiedTreeViewItem x:Class="RDAExplorerGUI.Misc.RDAFileTreeViewItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ammctrls="clr-namespace:RDAExplorerGUI.Controls"                           
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             MouseDoubleClick="ModifiedTreeViewItem_MouseDoubleClick">
    <ammctrls:ModifiedTreeViewItem.ContextMenu>
        <ContextMenu>
            <MenuItem Header="View" Name="context_Open" Click="context_Open_Click">
                <MenuItem.Icon>
                    <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/folder.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Extract" Name="context_Extract" Click="context_Extract_Click">
                <MenuItem.Icon>
                    <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/page_white_copy.png" />
                </MenuItem.Icon>
            </MenuItem>               
            <MenuItem Header="Delete" Name="context_Delete" Click="context_Delete_Click">
                <MenuItem.Icon>
                    <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/delete.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </ammctrls:ModifiedTreeViewItem.ContextMenu>
</ammctrls:ModifiedTreeViewItem>
