<Window x:Class="RDAExplorerGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="clr-namespace:RDAExplorerGUI.Controls"
        Title="Anno 1404 RDA Explorer" Height="480" Width="640" Activated="Window_Activated" Loaded="Window_Loaded" Closing="MainWindow_Closing" Icon="/RDAExplorerGUI;component/Images/Icon_16.ico">
    <DockPanel>
		<Menu VerticalAlignment="Top" Background="{DynamicResource Brush_UI_White}" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
			<MenuItem Header="File">
                <MenuItem Header="New" Name="file_New" Click="file_New_Click">
                    <MenuItem.Icon>
                        <Image Source="/RDAExplorerGUI;component/Images/Icons/page_white.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Open (Read only)" Name="file_OpenReadOnly" Click="file_OpenReadOnly_Click">
                    <MenuItem.Icon>
                        <Image Source="/RDAExplorerGUI;component/Images/folder_link.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open" Name="file_Open" Click="file_Open_Click">
                    <MenuItem.Icon>
                        <Image Source="/RDAExplorerGUI;component/Images/Icons/folder.png" />
                    </MenuItem.Icon>
                </MenuItem>               
				<MenuItem Header="Save" Name="file_Save" IsEnabled="True" Click="file_Save_Click">
                    <MenuItem.Icon>
                        <Image Source="/RDAExplorerGUI;component/Images/Icons/disk.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save as ..." Name="file_SaveAs" IsEnabled="True" Click="file_SaveAs_Click">
                    <MenuItem.Icon>
                        <Image Source="/RDAExplorerGUI;component/Images/Icons/disk_multiple.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
				<MenuItem Header="Exit" Name="file_Exit" Click="file_Exit_Click">
                    <MenuItem.Icon>
                        <Image Source="/RDAExplorerGUI;component/Images/Icons/cross.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
			<MenuItem Header="Tools">
				<MenuItem Header="Extract all" Name="archive_ExtractAll" Click="archive_ExtractAll_Click">
                    <MenuItem.Icon>
                        <Image Source="/RDAExplorerGUI;component/Images/Icons/page_white_copy.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Extract selected" Name="archive_ExtractSelected" Click="archive_ExtractSelected_Click">
                    <MenuItem.Icon>
                        <Image Source="/RDAExplorerGUI;component/Images/Icons/page_white_copy.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Add folder as root ..." Name="tools_AddFolderAsRoot" Click="context_AddFolderAsRoot_Click">
                    <MenuItem.Icon>
                        <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/add.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
				<MenuItem Header="Search file" Name="archive_SearchFile" Click="archive_SearchFile_Click">
                    <MenuItem.Icon>
                        <Image Source="Images/Icons/zoom.png" />
                    </MenuItem.Icon>
                </MenuItem>
				<MenuItem Header="Search folder" Name="archive_SearchFolder" Click="archive_SearchFolder_Click">
                    <MenuItem.Icon>
                        <Image Source="Images/Icons/zoom.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
		</Menu>
		<Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush_UI_White}" BorderBrush="{DynamicResource Brush_UI_Border}" BorderThickness="0,1,0,0">
			<DockPanel Height="21.96">
				<TextBlock x:Name="label_Status" TextWrapping="Wrap" Text="" Margin="3,3,0,3"/>
			</DockPanel>
		</Border>
		<ProgressBar Background="White" Height="10" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush_UI_Border}" Foreground="{DynamicResource Brush_UI_Blue}" x:Name="progressBar_Status" BorderThickness="0,1,0,0" Visibility="Collapsed" />
        <ctrls:MultiSelectTreeView AutoRecursive="True" BorderBrush="{x:Null}" BorderThickness="0" x:Name="treeView" >
            <!--<ctrls:MultiSelectTreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Extract all" Name="context_ExtractAll" Click="archive_ExtractAll_Click">
                        <MenuItem.Icon>
                            <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/page_white_copy.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Add files ..." Name="context_AddFiles" Click="context_AddFiles_Click">
                        <MenuItem.Icon>
                            <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/add.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Add folder ..." Name="context_AddFolder" Click="context_AddFolder_Click">
                        <MenuItem.Icon>
                            <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/add.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Add folder as root ..." Name="context_AddFolderAsRoot" Click="context_AddFolderAsRoot_Click">
                        <MenuItem.Icon>
                            <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/add.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="New folder" Name="context_NewFolder" Click="context_NewFolder_Click">
                        <MenuItem.Icon>
                            <Image Width="16" Height="16" Source="/RDAExplorerGUI;component/Images/Icons/folder_add.png" />
                        </MenuItem.Icon>
